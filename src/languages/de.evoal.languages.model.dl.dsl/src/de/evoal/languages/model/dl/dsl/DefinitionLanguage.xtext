grammar de.evoal.languages.model.dl.dsl.DefinitionLanguage with de.evoal.languages.model.base.dsl.BaseLanguage

import "https://www.evoal.de/languages/dl/1.0.0"
import "https://www.evoal.de/languages/ddl/1.0.0" as ddl
import "https://www.evoal.de/languages/base/expressions/1.0.0" as expr
import "https://www.evoal.de/languages/base/types/1.0.0" as types


DefinitionModelRule returns DefinitionModule:
	(imports += ImportRule)*
	'module' name = QualifiedName '{'
		((types += TypeDefinitionRule ) | (functions += FunctionDefinitionRule ) | constants += ConstantDefinitionRule)*
	'}'
;

