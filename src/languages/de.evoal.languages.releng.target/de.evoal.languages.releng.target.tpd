target "EvoAl Languages Target"

with requirements, source

location "https://download.eclipse.org/releases/2025-12/" {
  org.eclipse.equinox.sdk.feature.group lazy
  org.eclipse.equinox.p2.sdk.feature.group lazy
  org.eclipse.xtext.sdk.feature.group lazy
  org.eclipse.graphiti.feature.feature.group lazy

  // IDE for starting a debug eclipse
  org.eclipse.platform.feature.group lazy
  org.antlr.runtime [3.2.0,4.0.0)
  slf4j.api lazy
  org.apache.commons.logging lazy
}

location "https://download.eclipse.org/tools/orbit/simrel/orbit-aggregation/2025-12" {
	junit-jupiter-api lazy
}

location "https://typefox.github.io/xtext2langium/download/updates/v0.4.0/" {
	io.typefox.xtext2langium lazy
}