    modelPluginID="de.evoal.languages.model.constraints" forceOverwrite="true" modelName="constraints"
    updateClasspath="false" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    importerID="org.eclipse.emf.importer.ecore" complianceLevel="8.0" copyrightFields="false"
    runtimeVersion="2.44" usedGenPackages="../../de.evoal.languages.model.base/model/definitions.genmodel#//definitions ../../de.evoal.languages.model.base/model/expressions.genmodel#//expressions ../../de.evoal.languages.model.base/model/types.genmodel#//types">
  <foreignModel>model.ecore</foreignModel>
  <genPackages prefix="Constraints" basePackage="de.evoal.languages.model" disposableProviderFactory="true"
      fileExtensions="constraints" ecorePackage="model.ecore#/">
    <genDataTypes ecoreDataType="model.ecore#//ENumber"/>
    <genDataTypes ecoreDataType="model.ecore#//Diagnostic"/>
    <genClasses image="false" ecoreClass="model.ecore#//Constraint">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference model.ecore#//Constraint/features"/>
      <genOperations ecoreOperation="model.ecore#//Constraint/check">
        <genParameters ecoreParameter="model.ecore#//Constraint/check/object"/>
      </genOperations>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//LowerBoundaryConstraint">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//LowerBoundaryConstraint/boundary"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//LowerBoundaryConstraint/inclusive"/>
      <genOperations ecoreOperation="model.ecore#//LowerBoundaryConstraint/check"
          body="final &lt;%org.eclipse.emf.ecore.EStructuralFeature%> feature = features.get(0);&#xA;final Number value = (Number)object.eGet(feature);&#xA;&#xA;boolean violates = true;&#xA;if(isInclusive()) {&#xA;&#x9;violates = &lt;%de.evoal.languages.model.interpreter.BooleanNumberOperations%>.isLesserThan(value, boundary);&#xA;} else {&#xA;&#x9;violates = BooleanNumberOperations.isLesserThanOrEqualTo(value, boundary);&#xA;}&#xA;&#xA;if(violates) {&#xA;&#x9;return new &lt;%org.eclipse.emf.common.util.BasicDiagnostic%>(&#xA;&#x9;&#x9;Diagnostic.ERROR,&#xA;&#x9;&#x9;&lt;%de.evoal.languages.model.constraints.ConstraintsPackage%>.eNS_URI,&#xA;&#x9;&#x9;0,&#xA;&#x9;&#x9;&quot;Value &quot; + value + &quot; of &quot; + feature.getName() + &quot; is below lower bound of &quot; + boundary.toString(),&#xA;&#x9;&#x9;new Object [] { object }&#xA;&#x9;);&#xA;}&#xA;&#xA;return Diagnostic.OK_INSTANCE;">
        <genParameters ecoreParameter="model.ecore#//LowerBoundaryConstraint/check/object"/>
      </genOperations>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//UpperBoundaryConstraint">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//UpperBoundaryConstraint/boundary"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//UpperBoundaryConstraint/inclusive"/>
      <genOperations ecoreOperation="model.ecore#//UpperBoundaryConstraint/check"
          body="final &lt;%org.eclipse.emf.ecore.EStructuralFeature%> feature = features.get(0);&#xA;final Number value = (Number)object.eGet(feature);&#xA;&#xA;boolean violates = true;&#xA;if(isInclusive()) {&#xA;&#x9;violates = &lt;%de.evoal.languages.model.interpreter.BooleanNumberOperations%>.isLesserThanOrEqualTo(boundary, value);&#xA;} else {&#xA;&#x9;violates = BooleanNumberOperations.isLesserThan(boundary, value);&#xA;}&#xA;&#xA;if(violates) {&#xA;&#x9;return new &lt;%org.eclipse.emf.common.util.BasicDiagnostic%>(&#xA;&#x9;&#x9;Diagnostic.ERROR,&#xA;&#x9;&#x9;&lt;%de.evoal.languages.model.constraints.ConstraintsPackage%>.eNS_URI,&#xA;&#x9;&#x9;0,&#xA;&#x9;&#x9;&quot;Value &quot; + value + &quot; of &quot; + feature.getName() + &quot; is above upper bound of &quot; + boundary.toString(),&#xA;&#x9;&#x9;new Object [] { object }&#xA;&#x9;);&#xA;}&#xA;&#xA;return Diagnostic.OK_INSTANCE;">
        <genParameters ecoreParameter="model.ecore#//UpperBoundaryConstraint/check/object"/>
      </genOperations>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//MultiVariateConstraint">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference model.ecore#//MultiVariateConstraint/condition"/>
      <genOperations ecoreOperation="model.ecore#//MultiVariateConstraint/check" body="final &lt;%org.eclipse.emf.ecore.EStructuralFeature%> feature = features.get(0);&#xA;final Number value = (Number)object.eGet(feature);&#xA;&#xA;boolean violates = true;&#xA;if(isInclusive()) {&#xA;&#x9;violates = &lt;%de.evoal.languages.model.interpreter.BooleanNumberOperations%>.isLesserThanOrEqualTo(boundary, value);&#xA;} else {&#xA;&#x9;violates = BooleanNumberOperations.isLesserThan(boundary, value);&#xA;}&#xA;&#xA;if(violates) {&#xA;&#x9;return new &lt;%org.eclipse.emf.common.util.BasicDiagnostic%>(&#xA;&#x9;&#x9;Diagnostic.ERROR,&#xA;&#x9;&#x9;&lt;%de.evoal.languages.model.constraints.ConstraintsPackage%>.eNS_URI,&#xA;&#x9;&#x9;0,&#xA;&#x9;&#x9;&quot;Value &quot; + value + &quot; of &quot; + feature.getName() + &quot; is above upper bound of &quot; + boundary.toString(),&#xA;&#x9;&#x9;new Object [] { object }&#xA;&#x9;);&#xA;}&#xA;&#xA;return Diagnostic.OK_INSTANCE;">
        <genParameters ecoreParameter="model.ecore#//MultiVariateConstraint/check/object"/>
