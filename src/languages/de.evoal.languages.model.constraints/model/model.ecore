<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="constraints" nsURI="https://www.evoal.de/languages/constraints/1.0.0"
    nsPrefix="constraints">
  <eAnnotations source="http://www.eclipse.org/OCL/Import">
    <details key="base" value="platform:/resource/de.evoal.languages.model.base/model/model.ecore#/"/>
    <details key="ecore" value="http://www.eclipse.org/emf/2002/Ecore"/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Constraint" abstract="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;Base class for any constraint.&#xA;"/>
    </eAnnotations>
    <eOperations name="check" lowerBound="1" eType="#//Diagnostic">
      <eParameters name="object" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="features" ordered="false"
        lowerBound="1" upperBound="-1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="false"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="ENumber" instanceClassName="java.lang.Number"
      serializable="false"/>
  <eClassifiers xsi:type="ecore:EClass" name="LowerBoundaryConstraint" eSuperTypes="#//Constraint">
    <eAnnotations source="https://www.evoal.de/languages/constraints/1.0.0/EvoAlType">
      <details key="name" value="de.evoal.core.constraints.LowerBoundary"/>
    </eAnnotations>
    <eOperations name="check" lowerBound="1" eType="#//Diagnostic">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="final &lt;%org.eclipse.emf.ecore.EStructuralFeature%> feature = features.get(0);&#xA;final Number value = (Number)object.eGet(feature);&#xA;&#xA;boolean violates = true;&#xA;if(isInclusive()) {&#xA;&#x9;violates = &lt;%de.evoal.languages.model.interpreter.BooleanNumberOperations%>.isLesserThan(value, boundary);&#xA;} else {&#xA;&#x9;violates = BooleanNumberOperations.isLesserThanOrEqualTo(value, boundary);&#xA;}&#xA;&#xA;if(violates) {&#xA;&#x9;return new &lt;%org.eclipse.emf.common.util.BasicDiagnostic%>(&#xA;&#x9;&#x9;Diagnostic.ERROR,&#xA;&#x9;&#x9;&lt;%de.evoal.languages.model.constraints.ConstraintsPackage%>.eNS_URI,&#xA;&#x9;&#x9;0,&#xA;&#x9;&#x9;&quot;Value &quot; + value + &quot; of &quot; + feature.getName() + &quot; is below lower bound of &quot; + boundary.toString(),&#xA;&#x9;&#x9;new Object [] { object }&#xA;&#x9;);&#xA;}&#xA;&#xA;return Diagnostic.OK_INSTANCE;"/>
      </eAnnotations>
      <eParameters name="object" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="boundary" lowerBound="1"
        eType="#//ENumber" transient="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inclusive" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="UpperBoundaryConstraint" eSuperTypes="#//Constraint">
    <eAnnotations source="https://www.evoal.de/languages/constraints/1.0.0/EvoAlType">
      <details key="name" value="de.evoal.core.constraints.UpperBoundary"/>
    </eAnnotations>
    <eOperations name="check" lowerBound="1" eType="#//Diagnostic">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="final &lt;%org.eclipse.emf.ecore.EStructuralFeature%> feature = features.get(0);&#xA;final Number value = (Number)object.eGet(feature);&#xA;&#xA;boolean violates = true;&#xA;if(isInclusive()) {&#xA;&#x9;violates = &lt;%de.evoal.languages.model.interpreter.BooleanNumberOperations%>.isLesserThanOrEqualTo(boundary, value);&#xA;} else {&#xA;&#x9;violates = BooleanNumberOperations.isLesserThan(boundary, value);&#xA;}&#xA;&#xA;if(violates) {&#xA;&#x9;return new &lt;%org.eclipse.emf.common.util.BasicDiagnostic%>(&#xA;&#x9;&#x9;Diagnostic.ERROR,&#xA;&#x9;&#x9;&lt;%de.evoal.languages.model.constraints.ConstraintsPackage%>.eNS_URI,&#xA;&#x9;&#x9;0,&#xA;&#x9;&#x9;&quot;Value &quot; + value + &quot; of &quot; + feature.getName() + &quot; is above upper bound of &quot; + boundary.toString(),&#xA;&#x9;&#x9;new Object [] { object }&#xA;&#x9;);&#xA;}&#xA;&#xA;return Diagnostic.OK_INSTANCE;"/>
      </eAnnotations>
      <eParameters name="object" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="boundary" lowerBound="1"
        eType="#//ENumber" transient="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="inclusive" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" defaultValueLiteral="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="Diagnostic" instanceClassName="org.eclipse.emf.common.util.Diagnostic"/>
  <eClassifiers xsi:type="ecore:EClass" name="MultiVariateConstraint" eSuperTypes="#//Constraint">
    <eAnnotations source="https://www.evoal.de/languages/constraints/1.0.0/EvoAlType">
      <details key="name" value="de.evoal.core.constraints.Constraint"/>
    </eAnnotations>
    <eOperations name="check" lowerBound="1" eType="#//Diagnostic">
      <eParameters name="object" lowerBound="1" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EObject"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="condition" lowerBound="1"
        eType="ecore:EClass ../../de.evoal.languages.model.base/model/model.ecore#//Expression"
        containment="true"/>
  </eClassifiers>
</ecore:EPackage>
