<?xml version="1.0" encoding="UTF-8"?>
<genmodel:GenModel xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore"
    xmlns:genmodel="http://www.eclipse.org/emf/2002/GenModel" modelDirectory="/de.evoal.languages.model.ddl/src-gen" editDirectory="/de.evoal.languages.model.ddl.edit/src-gen"
    editorDirectory="/de.evoal.languages.model.ddl.editor/src-gen" modelPluginID="de.evoal.languages.model.ddl"
    modelName="Ddl" editPluginClass="de.evoal.languages.model.ddl.provider.DdlEditPlugin"
    editorPluginClass="de.evoal.languages.model.ddl.presentation.DdlEditorPlugin"
    rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container" testsDirectory="/de.evoal.languages.model.ddl.tests/src-gen"
    testSuiteClass="de.evoal.languages.model.ddl.tests.DvmAllTests" importerID="org.eclipse.emf.importer.ecore"
    complianceLevel="8.0" copyrightFields="false" editPluginID="de.evoal.languages.model.ddl.edit"
    editorPluginID="de.evoal.languages.model.ddl.editor" usedGenPackages="../../de.evoal.languages.model.dl/model/model.genmodel#//dl ../../de.evoal.languages.model.el/model/model.genmodel#//el"
    importOrganizing="true">
  <foreignModel>model.ecore</foreignModel>
  <genPackages prefix="Ddl" basePackage="de.evoal.languages.model" disposableProviderFactory="true"
      ecorePackage="model.ecore#/">
    <genEnums typeSafeEnumCompatible="false" ecoreEnum="model.ecore#//ScaleType">
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//ScaleType/Nominal"/>
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//ScaleType/Ordinal"/>
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//ScaleType/Cardinal"/>
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//ScaleType/Quotient"/>
    </genEnums>
    <genEnums typeSafeEnumCompatible="false" ecoreEnum="model.ecore#//RepresentationType">
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//RepresentationType/Real"/>
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//RepresentationType/Integer"/>
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//RepresentationType/Boolean"/>
      <genEnumLiterals ecoreEnumLiteral="model.ecore#//RepresentationType/String"/>
    </genEnums>
    <genClasses ecoreClass="model.ecore#//DataDescriptionModel">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference model.ecore#//DataDescriptionModel/uses"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference model.ecore#//DataDescriptionModel/types"/>
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference model.ecore#//DataDescriptionModel/descriptions"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference model.ecore#//DataDescriptionModel/constraints"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//Use">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//Use/importURI"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//DataType">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//DataType/scale"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//DataType/name"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//DataType/description"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference model.ecore#//DataType/constraints"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//DataDescription">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//DataDescription/name"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference model.ecore#//DataDescription/constraints"/>
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//DataDescription/representation"/>
      <genOperations ecoreOperation="model.ecore#//DataDescription/getScale"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//TypedDataDescription">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference model.ecore#//TypedDataDescription/type"/>
      <genOperations ecoreOperation="model.ecore#//TypedDataDescription/getScale"
          body="return getType() == null ? null : getType().getScale();"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//UntypedDataDescription">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute model.ecore#//UntypedDataDescription/scale"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//FunctionName">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference model.ecore#//FunctionName/definition"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//DataReference">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference model.ecore#//DataReference/definition"/>
    </genClasses>
    <genClasses ecoreClass="model.ecore#//SelfReference"/>
  </genPackages>
</genmodel:GenModel>
