      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute expressions.ecore#//StringLiteral/literal"/>
      <genOperations ecoreOperation="expressions.ecore#//StringLiteral/getValue" body="return literal;&#xA;"/>
    </genClasses>
    <genClasses ecoreClass="expressions.ecore#//Instance">
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference expressions.ecore#//Instance/definition"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference expressions.ecore#//Instance/attributes"/>
      <genOperations ecoreOperation="expressions.ecore#//Instance/findAttribute" body="return this.getAttributes()&#xA;                 .stream()&#xA;                 .filter(n -> name.equals(n.getDefinition().getName()))&#xA;                 .findFirst()&#xA;                 .orElse(null);">
        <genParameters ecoreParameter="expressions.ecore#//Instance/findAttribute/name"/>
      </genOperations>
