    <genClasses ecoreClass="expressions.ecore#//IntegerLiteral">
      <genFeatures createChild="false" ecoreFeature="ecore:EAttribute expressions.ecore#//IntegerLiteral/literal"/>
      <genOperations ecoreOperation="expressions.ecore#//IntegerLiteral/getValue"
          body="return (int)(literal * Math.pow(10, super.getFactor().getValue()));&#xA;"/>
    </genClasses>
    <genClasses ecoreClass="expressions.ecore#//RealLiteral">
