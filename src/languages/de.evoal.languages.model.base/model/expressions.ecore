  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ValueDefinitionReference" eSuperTypes="#//ValueReference">
    <eOperations name="isEnumLiteralReference" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="body" value="return this.getDefinition() instanceof &lt;%de.evoal.languages.model.base.definitions.LiteralDefinition%>;"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="isAttributeReference" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
