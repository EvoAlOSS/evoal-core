        <details key="body" value="return this.getDefinition() instanceof &lt;%de.evoal.languages.model.base.definitions.AttributeDefinition%>;&#xA;"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="definition" lowerBound="1"
