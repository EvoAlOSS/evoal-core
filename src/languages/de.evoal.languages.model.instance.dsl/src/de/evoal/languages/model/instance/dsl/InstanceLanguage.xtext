grammar de.evoal.languages.model.instance.dsl.InstanceLanguage with de.evoal.languages.model.base.dsl.BaseLanguage

import "https://www.evoal.de/languages/instance/1.0.0" 

import "https://www.evoal.de/languages/ddl/1.0.0" as ddl
import "https://www.evoal.de/languages/base/1.0.0" as base



@Override
ReferenceRule returns base::ValueReference:
	ConstantReferenceRule | DataReferenceRule
;

DataReferenceRule returns DataReference:
	{DataReference}
	'data' definition = [ddl::DataDescription|StringOrId]
;