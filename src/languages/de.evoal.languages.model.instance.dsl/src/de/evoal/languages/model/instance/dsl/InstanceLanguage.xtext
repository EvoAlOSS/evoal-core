grammar de.evoal.languages.model.instance.dsl.InstanceLanguage with de.evoal.languages.model.base.dsl.BaseLanguage

import "https://www.evoal.de/languages/instance/1.0.0" 

import "https://www.evoal.de/languages/ddl/1.0.0" as ddl
import "https://www.evoal.de/languages/base/definitions/1.0.0" as defs
import "https://www.evoal.de/languages/base/expressions/1.0.0" as expr

InstanceModuleRule returns InstanceModule:
	{InstanceModule}
	(imports += ImportRule)*
	
	'instances' '=' '['
	  ('instance' instances += InstanceLiteralRule (',' 'instance' instances += InstanceLiteralRule)*)?
	']' ';'	
;