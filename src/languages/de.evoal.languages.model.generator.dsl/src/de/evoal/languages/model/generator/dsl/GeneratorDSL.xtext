grammar de.evoal.languages.model.generator.dsl.GeneratorDSL with de.evoal.languages.model.instance.dsl.InstanceLanguage

import "https://www.evoal.de/languages/generator/1.0.0"
import "https://www.evoal.de/languages/base/1.0.0" as base

ConfigurationRule returns Configuration:
	(imports += ImportRule)*
	(pipelines += PipelineDefinitionRule)*

	(statements	+= StatementRule)*
;

ImportRule returns Import:
	'import' importedNamespace = QualifiedName ';'
;


PipelineDefinitionRule returns PipelineDefinition:
	'pipeline' name = StringOrId '['
		steps += StepRule*
	']'
;

StepRule returns Step:
	'step' '{'
 	    'component' instance = InstanceLiteralRule
 	    ('reads' '[' (reads += DataReferenceRule (',' reads += DataReferenceRule)*)? ']' ';')?
 	    ('writes' '[' (writes += DataReferenceRule (',' writes += DataReferenceRule)*)? ']' ';')?
	'}'
;

StatementRule returns Statement:
	ForStatementRule | ApplyStatementRule	
;

ForStatementRule returns ForStatement:
	'for' name = ID 'in' range = RangeRule 'loop'
		(statements += StatementRule)*
	'end'
;

RangeRule returns Range:
	PipelineArrayRule | CounterRangeRule
;

CounterRangeRule returns CounterRange:
	'[' start = INT 'to' end = INT ']'
;

PipelineArrayRule returns PipelineArray:
	{PipelineArray} 'pipelines' ('[' references += PipelineReferenceRule (',' references += PipelineReferenceRule)* ']')?
;

PipelineReferenceRule returns PipelineReference:
	PipelineDefinitionReferenceRule | VariableReferenceRule;
	
PipelineDefinitionReferenceRule returns PipelineDefinitionReference:
	'pipeline' pipeline = [PipelineDefinition|StringOrId]
;

VariableReferenceRule returns VariableReference:
	loop = [ForStatement|ID]
;


ApplyStatementRule returns ApplyStatement:
	'write' file = STRING 'with' count = INT 'samples' 'from' 'executing' '[' pipelines += PipelineReferenceRule (',' pipelines += PipelineReferenceRule)* ']' ';'
;