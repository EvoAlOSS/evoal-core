<?xml version="1.0" encoding="UTF-8" ?> 
<templates>
	<template autoinsert="true"
			  context="de.evoal.languages.model.ddl.dsl.DataDescriptionLanguage.DataTypeRule"
			  deleted="false"
			  description="Creates a data type definition"
			  enabled="true"
			  id="de.evoal.languages.model.ddl.dsl.ui.templates.createdatatype"
			  name="New data type">${quotient:Enum('ScaleType')} type '${name}'
  description: "${description}"
    ${cursor};</template>

	<template autoinsert="true"
			  context="de.evoal.languages.model.ddl.dsl.DataDescriptionLanguage.DataTypeRule"
			  deleted="false"
			  description="Creates a data type definition with constraints"
			  enabled="true"
			  id="de.evoal.languages.model.ddl.dsl.ui.templates.createdatatypewithconstraints"
			  name="New constrainted data type">${quotient:Enum('ScaleType')} type '${name}'
  description: "${description}"
  with constraints:
    ${cursor};</template>

	<template autoinsert="true"
			  context="de.evoal.languages.model.ddl.dsl.DataDescriptionLanguage.DataDescriptionRule"
			  deleted="false"
			  description="Creates an untyped data definition"
			  enabled="true"
			  id="de.evoal.languages.model.ddl.dsl.ui.templates.createuntypeddata"
			  name="New untyped data">${quotient:Enum('ScaleType')} ${real:Enum('RepresentationType')} data '${name}'
		    ${cursor};</template>


	<template autoinsert="true"
			  context="de.evoal.languages.model.ddl.dsl.DataDescriptionLanguage.DataDescriptionRule"
			  deleted="false"
			  description="Creates a typed data definition"
			  enabled="true"
			  id="de.evoal.languages.model.ddl.dsl.ui.templates.createtypeddata"
			  name="New typed data">${real:Enum('RepresentationType')} data ${Name} of type ${Type:CrossReference('TypedDataDescription.type')}
		    ${cursor};</template>
	
</templates>