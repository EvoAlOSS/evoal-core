Eclipse-LazyStart: true
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-1.8
Export-Package: de.evoal.languages.model.execution,
 de.evoal.languages.model.execution.impl,
 de.evoal.languages.model.execution.util,
 de.evoal.languages.model.generator,
 de.evoal.languages.model.generator.impl,
 de.evoal.languages.model.generator.util,
 de.evoal.languages.model.pipeline,
