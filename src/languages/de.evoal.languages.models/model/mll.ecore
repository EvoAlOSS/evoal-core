    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Entry point for the model."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="imports" ordered="false"
