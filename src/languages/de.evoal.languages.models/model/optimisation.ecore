  <eSubpackages name="memory" nsURI="https://evoal.de/v202704/models/optimisation/memory"
      nsPrefix="mem">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="*&#xA;The memory model of the optimization.&#xA;"/>
    </eAnnotations>
    <eClassifiers xsi:type="ecore:EClass" name="Execution">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;A single optimisation run.&#xA;"/>
      </eAnnotations>
      <eStructuralFeatures xsi:type="ecore:EReference" name="inputSpace" lowerBound="1"
          eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Definition of the input space (aka the search space of the&#xA;  optimisation problem).&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="outputSpace" lowerBound="1"
          eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Definition of the output space (aka the optimisation space of&#xA;  the optimisation problem).&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="states" upperBound="-1"
          eType="#//memory/State" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The memory states of the execution.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="metricDefinitions" upperBound="-1"
          eType="#//memory/MetricDefinition" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The metrics this execution and its iterations record. Every key of&#xA;  {@link #getMetrics()} and of {@link Iteration#getMetrics()} is defined here.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="metrics" upperBound="-1"
          eType="#//memory/MetricEntry" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The values of the metrics that describe the whole execution, e.g.,&#xA;  limits, by metric name. The metrics are defined in&#xA;  {@link #getMetricDefinitions()} with the scope {@link MetricScope#EXECUTION}.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="State" abstract="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;Base class for memory states.&#xA;"/>
      </eAnnotations>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="Iteration" eSuperTypes="#//memory/State">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;A memory state for iteration-based algorithms.&#xA;"/>
      </eAnnotations>
      <eOperations name="bestIndividuals" lowerBound="1">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return getRanks()&#xA;.get(0)&#xA;.getMembers()&#xA;.stream();&#xA;"/>
          <details key="documentation" value="*&#xA;Returns a stream of the best individuals that survived the iteration.&#xA;"/>
        </eAnnotations>
        <eGenericType eClassifier="#//Stream">
          <eTypeArguments eClassifier="#//memory/Individual"/>
        </eGenericType>
      </eOperations>
      <eOperations name="survivedIndividuals" lowerBound="1">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return getRanks()&#xA;.stream()&#xA;.flatMap(r -> r.getMembers().stream());&#xA;"/>
          <details key="documentation" value="*&#xA;Returns a stream of the individuals that survived the iteration.&#xA;"/>
        </eAnnotations>
        <eGenericType eClassifier="#//Stream">
          <eTypeArguments eClassifier="#//memory/Individual"/>
        </eGenericType>
      </eOperations>
      <eOperations name="numberOfSurvivedIndividuals" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return (int) survivedIndividuals().count();&#xA;"/>
          <details key="documentation" value="*&#xA;Calculates the number of individuals that survive the iteration.&#xA;  This excludes individuals that were created as intermediate&#xA;  individuals but that are not passed to next generation.&#xA;&#xA;@return Positive number of individuals.&#xA;*&#xA;Negation of the method {@link #shouldTerminate}.&#xA;"/>
        </eAnnotations>
      </eOperations>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="number" lowerBound="1"
          eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The iteration number. Please note that iteration 0 represents&#xA;  the initial population. The iteration numbers are used&#xA;  consecutively.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="steps" upperBound="-1"
          eType="#//memory/IterationStep" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Intermediate iteration steps, e.g., recombination and mutation.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="ranks" upperBound="-1"
          eType="#//memory/Rank" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The final individuals of the iteration.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EReference" name="metrics" upperBound="-1"
          eType="#//memory/MetricEntry" containment="true">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The values of the metrics at the end of the iteration, by metric&#xA;  name. The metrics are defined in {@link Execution#getMetricDefinitions()}&#xA;  with the scope {@link MetricScope#ITERATION}.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
    </eClassifiers>
