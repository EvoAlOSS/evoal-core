        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;What the metric measures.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="MetricKind">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;How a metric changes over the iterations.&#xA;"/>
      </eAnnotations>
      <eLiterals name="Counter">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The value never decreases, e.g., the number of evaluations.&#xA;"/>
        </eAnnotations>
      </eLiterals>
      <eLiterals name="Measure" value="1">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The value can change arbitrarily, e.g., the diversity of a population.&#xA;"/>
        </eAnnotations>
      </eLiterals>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="MetricValueType">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;The type of a metric's values.&#xA;"/>
      </eAnnotations>
      <eLiterals name="Integer">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Integral values, stored as {@link Long}.&#xA;"/>
        </eAnnotations>
      </eLiterals>
      <eLiterals name="Real" value="1">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Real values, stored as {@link Double}.&#xA;"/>
        </eAnnotations>
      </eLiterals>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="MetricScope">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;Where the values of a metric are recorded.&#xA;"/>
      </eAnnotations>
      <eLiterals name="Execution">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Once for the whole execution ({@link Execution#getMetrics()}), e.g., a limit.&#xA;"/>
        </eAnnotations>
      </eLiterals>
      <eLiterals name="Iteration" value="1">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;In every iteration ({@link Iteration#getMetrics()}), e.g., the number of evaluations so far.&#xA;"/>
        </eAnnotations>
      </eLiterals>
    </eClassifiers>
  </eSubpackages>
  <eSubpackages name="execution" nsURI="https://evoal.de/v202704/models/optimisation/execution"
      nsPrefix="exec">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="*&#xA;Package containing interfaces for a common execution of all algorithms.&#xA;"/>
    </eAnnotations>
    <eClassifiers xsi:type="ecore:EClass" name="OptimisationFunction">
      <eAnnotations source="https://evoal.de/v202610/models/core/configured-by">
        <details key="type" value="de.evoal.optimisation.core.optimisation-function"/>
      </eAnnotations>
      <eOperations name="evaluate" lowerBound="1" eType="#//TypedEObject">
        <eParameters name="input" lowerBound="1" eType="#//TypedEObject"/>
      </eOperations>
      <eGenericSuperTypes eClassifier="ecore:EClass core.ecore#//EvoalComponent">
        <eTypeArguments eClassifier="#//execution/OptimisationFunction"/>
      </eGenericSuperTypes>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="TerminationCriterion">
      <eAnnotations source="https://evoal.de/v202610/models/core/configured-by">
        <details key="type" value="de.evoal.optimisation.core.stopping-criterion"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;The algorithm's termination criterion. It checks, based on the current&#xA;  iteration, if the algorithm should stop.&#xA;"/>
      </eAnnotations>
      <eOperations name="shouldTerminate" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Checks if the algorithm should terminate.&#xA;&#xA;@param iteration The iteration to check.&#xA;&#xA;@return &lt;code>true&lt;/code> iff the algorithm should terminate.&#xA;"/>
        </eAnnotations>
        <eParameters name="iteration" lowerBound="1" eType="#//memory/Iteration"/>
      </eOperations>
      <eOperations name="shouldContinue" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return !shouldTerminate(iteration);&#xA;"/>
          <details key="documentation" value="*&#xA;Negation of the method {@link #shouldTerminate}.&#xA;"/>
        </eAnnotations>
        <eParameters name="iteration" lowerBound="1" eType="#//memory/Iteration"/>
      </eOperations>
      <eGenericSuperTypes eClassifier="ecore:EClass core.ecore#//EvoalComponent">
        <eTypeArguments eClassifier="#//execution/TerminationCriterion"/>
      </eGenericSuperTypes>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="Selection">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;In several situations an optimisation algorithm selects a subset of&#xA;  a given set of individuals (there are different strategies of how&#xA;  to select these individuals.&#xA;&#xA;Please note that the input and output of this operation are not&#xA;  necessarily sets. Several selections strategies allow selecting an&#xA;  individual multiple times. Thus, in- and output are bags (without&#xA;  order and allowing elements to be contained multiple times).&#xA;"/>
      </eAnnotations>
      <eOperations name="select" lowerBound="1" eType="#//memory/IterationStep">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;The actual selection operation.&#xA;&#xA;@param input A bag of individuals.&#xA;&#xA;@return A bag of selected individuals.&#xA;"/>
        </eAnnotations>
        <eParameters name="input" lowerBound="1" eType="#//memory/IterationStep"/>
      </eOperations>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="OptimisationValue" abstract="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="*&#xA;The optimisation value is an abstract type that allows comparing them.&#xA;  The information stored depend on the concrete implementation.&#xA;"/>
      </eAnnotations>
      <eOperations name="isBetter" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return this.compareTo(other) > 0;&#xA;"/>
          <details key="documentation" value="*&#xA;Checks iff this value is better than the other.&#xA;"/>
        </eAnnotations>
        <eParameters name="other" lowerBound="1" eType="#//execution/OptimisationValue"/>
      </eOperations>
      <eOperations name="isEqual" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return this.compareTo(other) == 0;&#xA;"/>
          <details key="documentation" value="*&#xA;Checks iff two optimisation values are equal.&#xA;"/>
        </eAnnotations>
        <eParameters name="other" lowerBound="1" eType="#//execution/OptimisationValue"/>
      </eOperations>
      <eOperations name="isWorse" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="body" value="return this.compareTo(other) &lt; 0;&#xA;"/>
          <details key="documentation" value="*&#xA;Checks iff this value is worse than the other.&#xA;"/>
        </eAnnotations>
        <eParameters name="other" lowerBound="1" eType="#//execution/OptimisationValue"/>
      </eOperations>
      <eOperations name="toOptmisationSpace" lowerBound="1" eType="#//TypedEObject">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Returns the optimisation space value of the optimisation value.&#xA;"/>
        </eAnnotations>
      </eOperations>
      <eOperations name="toStatistics" lowerBound="1">
        <eGenericType eClassifier="#//List">
          <eTypeArguments eClassifier="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EJavaObject"/>
        </eGenericType>
      </eOperations>
      <eGenericSuperTypes eClassifier="#//Comparable">
        <eTypeArguments eClassifier="#//execution/OptimisationValue"/>
      </eGenericSuperTypes>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EClass" name="OptimisationValueWithDistance" abstract="true"
        eSuperTypes="#//execution/OptimisationValue">
      <eOperations name="distanceFrom" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble">
        <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
          <details key="documentation" value="*&#xA;Calculates the distance between two optimisation values.&#xA;"/>
        </eAnnotations>
        <eParameters name="other" lowerBound="1" eType="#//execution/OptimisationValue"/>
      </eOperations>
    </eClassifiers>
