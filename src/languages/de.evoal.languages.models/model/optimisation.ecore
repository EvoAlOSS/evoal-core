          <details key="documentation" value="*&#xA;Where the values of the metric are recorded.&#xA;"/>
        </eAnnotations>
      </eStructuralFeatures>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" lowerBound="1"
