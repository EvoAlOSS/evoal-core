import "definitions" from de.evoal.optimisation.core;
import "definitions" from de.evoal.optimisation.ea.optimisation;

module de.evoal.surrogate.optimisation {
	/**
	 * Calculating fitness value by using a surrogate function:<br/>
	 *
	 * <mathml>
	 *   <math>
	 *     <mrow>
	 *       <mi>f</mi>
	 *       <mi>i</mi>
	 *       <mi>t</mi>
	 *       <mi>n</mi>
	 *       <mi>e</mi>
	 *       <mi>s</mi>
	 *       <mi>s</mi>
	 *       <mo>=</mo>
	 *       <mi>s</mi>
	 *       <mi>u</mi>
	 *       <mi>r</mi>
	 *       <mi>r</mi>
	 *       <mi>o</mi>
	 *       <mi>g</mi>
	 *       <mi>a</mi>
	 *       <mi>t</mi>
	 *       <mi>e</mi>
	 *       <mo form="prefix" stretchy="false">(</mo>
	 *       <mi>i</mi>
	 *       <mi>n</mi>
	 *       <mi>d</mi>
	 *       <mo form="postfix" stretchy="false">)</mo>
	 *     </mrow>
	 *   </math>
	 * </mathml>
	 */
	type surrogate extends 'fitness-function' {
	}
	
	/**
	 * Use training data as initial population.
	 */
	type training extends 'initial-population' {
	    'training-file' : string;
	}
	
	/**
	 * Repair individuals with training data.
	 */
	type 'repair-with-training' extends 'repair-strategy' {
	}
	/**
	* The constraint statistics-writer collects information about the number of violated constraints. 
	* For each individual it collects the number of violated constraints by category. 
	*/
	type 'constraint-statistics' extends 'statistics-writer' {
	}
	
	/**
	* The correlated statistics-writer gives information about the difference between the current population's covariance matrix 
	* and the initial population's covariance matrix. To that end, it provides a difference measure as sum-of-squares as well 
	* as sum-of-absolutes. 
	*/
	type 'correlated' extends 'statistics-writer' {
	}
	
	/**
	* The range-correlated statistics-writer is an extension of the correlated statistics-writer. It measures the covariance matrix 		* differences per hypercube. Hypercubes are generated by the ranges that connections are given for. 
	*/ 
	type 'range-correlated' extends 'statistics-writer' {
	}

	/**
     * Writes the prediction values (before adaption) of every individual of every generation:
	 *
	 * <ul>
	 *   <li>generation</li>
	 *   <li>prediction-variable-1</li>
	 *   <li>prediction-variable-2</li>
	 *   ...
	 *   <li>prediction-variable-n</li>
	 * </ul>
     */
	type 'prediction-per-individual' extends 'statistics-writer' {
	}

}