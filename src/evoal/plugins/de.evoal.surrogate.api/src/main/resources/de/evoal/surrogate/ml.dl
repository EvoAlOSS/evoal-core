import "definitions" from 'de.evoal.core.base';

module de.evoal.surrogate.ml {
    /**
     * Base type for all surrogate functions.
     */
	abstract type surrogate extends configuration {
	}
	
	type 'r-squared' {}

	/**
	 * Runs a cross validation for a model training.
	 */
	def void 'cross-validation'(int times);

    /**
     * Calculates the coefficient of determination <i>R²</i> of every output feature on the
     * assessed data set (the training data while learning, the test data while testing):
     *
     * <math display="block">
     *   <mrow>
     *     <msup><mi>R</mi><mn>2</mn></msup>
     *     <mo>=</mo>
     *     <mn>1</mn>
     *     <mo>−</mo>
     *         <mfrac>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mover><mi>y</mi><mo stretchy="false">^</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mover><mi>y</mi><mo stretchy="false">¯</mo></mover><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *         </mfrac>
     *   </mrow>
     * </math>
     *
     * with the symbols of {@code rrse}. 1 is a perfect surrogate, 0 is as good as predicting
     * the mean, worse surrogates give negative values; on the same data
     * <i>R²</i> = 1 − <i>rrse</i>². If all values of a feature are equal, the measure is
     * undefined and is not written (a warning is logged).
     */
	def void 'R²'();

	/**
	 * Calculates the <i>root mean squared error</i> of every output feature on the assessed data
	 * set (the training data while learning, the test data while testing):
	 *
	 * <math display="block" class="tml-display" style="display:block math;">
     *   <mrow>
     *     <mi>r</mi>
     *     <mi>m</mi>
     *     <mi>s</mi>
     *     <mi>e</mi>
     *     <mo>=</mo>
     *     <msqrt>
     *       <mfrac>
     *         <mrow>
     *           <msubsup>
     *             <mo stretchy="true">∑</mo>
     *             <mrow>
     *               <mi>i</mi>
     *               <mo>=</mo>
     *               <mn>1</mn>
     *             </mrow>
     *             <mi>n</mi>
     *           </msubsup>
     *           <mrow>
     *             <mo form="prefix" stretchy="false" lspace="0em" rspace="0em">(</mo>
     *             <msub>
     *               <mi>y</mi>
     *               <mi>t</mi>
     *             </msub>
     *             <mo>−</mo>
     *             <msub>
     *               <mover>
     *                 <mi>y</mi>
     *                 <mo stretchy="false" class="tml-xshift" style="math-style:normal;math-depth:0;">^</mo>
     *               </mover>
     *               <mi>t</mi>
     *             </msub>
     *             <msup>
     *               <mo form="postfix" stretchy="false">)</mo>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *         </mrow>
     *         <mi>n</mi>
     *       </mfrac>
     *     </msqrt>
     *   </mrow>
     * </math>
	 */
	def void rmse();

	/**
	 * Calculates the <i>root relative squared error</i> of every output feature on the
	 * assessed data set (the training data while learning, the test data while testing; Witten, Frank and Hall, <i>Data Mining</i>, section "Evaluating numeric
	 * prediction"):
	 *
	 * <math display="block">
     *   <mrow>
     *     <mi>r</mi><mi>r</mi><mi>s</mi><mi>e</mi>
     *     <mo>=</mo>
     *     <msqrt>
     *         <mfrac>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mover><mi>y</mi><mo stretchy="false">^</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mover><mi>y</mi><mo stretchy="false">¯</mo></mover><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *         </mfrac>
     *     </msqrt>
     *   </mrow>
     * </math>
	 *
	 * where <i>y<sub>i</sub></i> are the values of the data set, <i>ŷ<sub>i</sub></i> the
	 * predictions of the surrogate and <i>ȳ</i> the mean of the values. It compares the error
	 * of the surrogate with the error of always predicting the mean: 0 is a perfect surrogate,
	 * 1 is as good as the mean. The value is a ratio, not a percentage. If all values of a
	 * feature are equal, the measure is undefined and is not written (a warning is logged).
	 */
	def void rrse();
}
