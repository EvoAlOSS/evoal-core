import "definitions" from 'de.evoal.core.base';

module de.evoal.surrogate.ml {
    /**
     * Base type for all surrogate functions.
     */
	abstract type surrogate extends configuration {
	}
	
	type 'r-squared' {}

    /**
     * Calculates the coefficient of determination <i>R²</i> of every output feature on the
     * assessed data set (the training data while learning, the test data while testing):
     *
     * <math display="block">
     *   <mrow>
     *     <msup><mi>R</mi><mn>2</mn></msup>
     *     <mo>=</mo>
     *     <mn>1</mn>
     *     <mo>−</mo>
     *         <mfrac>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mover><mi>y</mi><mo stretchy="false">^</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mover><mi>y</mi><mo stretchy="false">¯</mo></mover><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *         </mfrac>
     *   </mrow>
     * </math>
     *
     * with the symbols of {@code rrse}. 1 is a perfect surrogate, 0 is as good as predicting
     * the mean, worse surrogates give negative values; on the same data
     * <i>R²</i> = 1 − <i>rrse</i>². If all values of a feature are equal, the measure is
     * undefined and is not written (a warning is logged).
     */
	def void 'R²'();

	/**
	 * Calculates the <i>root mean squared error</i> of every output feature on the assessed data
	 * set (the training data while learning, the test data while testing):
	 *
	 * <math display="block" class="tml-display" style="display:block math;">
     *   <mrow>
     *     <mi>r</mi>
     *     <mi>m</mi>
     *     <mi>s</mi>
     *     <mi>e</mi>
     *     <mo>=</mo>
     *     <msqrt>
     *       <mfrac>
     *         <mrow>
     *           <msubsup>
     *             <mo stretchy="true">∑</mo>
     *             <mrow>
     *               <mi>i</mi>
     *               <mo>=</mo>
     *               <mn>1</mn>
     *             </mrow>
     *             <mi>n</mi>
     *           </msubsup>
     *           <mrow>
     *             <mo form="prefix" stretchy="false" lspace="0em" rspace="0em">(</mo>
     *             <msub>
     *               <mi>y</mi>
     *               <mi>t</mi>
     *             </msub>
     *             <mo>−</mo>
     *             <msub>
     *               <mover>
     *                 <mi>y</mi>
     *                 <mo stretchy="false" class="tml-xshift" style="math-style:normal;math-depth:0;">^</mo>
     *               </mover>
     *               <mi>t</mi>
     *             </msub>
     *             <msup>
     *               <mo form="postfix" stretchy="false">)</mo>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *         </mrow>
     *         <mi>n</mi>
     *       </mfrac>
     *     </msqrt>
     *   </mrow>
     * </math>
	 */
	def void rmse();

	/**
	 * Calculates the <i>root relative squared error</i> of every output feature on the
	 * assessed data set (the training data while learning, the test data while testing; Witten, Frank and Hall, <i>Data Mining</i>, section "Evaluating numeric
	 * prediction"):
	 *
	 * <math display="block">
     *   <mrow>
     *     <mi>r</mi><mi>r</mi><mi>s</mi><mi>e</mi>
     *     <mo>=</mo>
     *     <msqrt>
     *         <mfrac>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mover><mi>y</mi><mo stretchy="false">^</mo></mover><mi>i</mi></msub><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *           <mrow>
     *             <msubsup>
     *               <mo stretchy="true">∑</mo>
     *               <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
     *               <mi>n</mi>
     *             </msubsup>
     *             <msup>
     *               <mrow><mo fence="true" form="prefix">(</mo><msub><mi>y</mi><mi>i</mi></msub><mo>−</mo><mover><mi>y</mi><mo stretchy="false">¯</mo></mover><mo fence="true" form="postfix">)</mo></mrow>
     *               <mn>2</mn>
     *             </msup>
     *           </mrow>
     *         </mfrac>
     *     </msqrt>
     *   </mrow>
     * </math>
	 *
	 * where <i>y<sub>i</sub></i> are the values of the data set, <i>ŷ<sub>i</sub></i> the
	 * predictions of the surrogate and <i>ȳ</i> the mean of the values. It compares the error
	 * of the surrogate with the error of always predicting the mean: 0 is a perfect surrogate,
	 * 1 is as good as the mean. The value is a ratio, not a percentage. If all values of a
	 * feature are equal, the measure is undefined and is not written (a warning is logged).
	 */
	def void rrse();

	/**
	 * Calculates the <i>prediction interval coverage probability</i> of every output feature on
	 * the assessed data set (the training data while learning, the test data while testing;
	 * Khosravi, Nahavandi, Creighton and Atiya 2011, https://doi.org/10.1109/TNN.2011.2162110):
	 *
	 * <math display="block">
	 *   <mrow>
	 *     <mi>p</mi><mi>i</mi><mi>c</mi><mi>p</mi>
	 *     <mo>=</mo>
	 *     <mfrac>
	 *       <mn>1</mn>
	 *       <mi>n</mi>
	 *     </mfrac>
	 *     <msubsup>
	 *       <mo stretchy="true">∑</mo>
	 *       <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
	 *       <mi>n</mi>
	 *     </msubsup>
	 *     <msub><mi>c</mi><mi>i</mi></msub>
	 *   </mrow>
	 * </math>
	 *
	 * where <i>c<sub>i</sub></i> is 1 if the value <i>y<sub>i</sub></i> of the data set lies in
	 * the prediction interval [<i>L<sub>i</sub></i>, <i>U<sub>i</sub></i>] of the surrogate
	 * (bounds included) and 0 otherwise. The share is in [0, 1]; for a well-calibrated surrogate
	 * it is close to the coverage of its interval, e.g. 'coverage' of 'gradient-boosting'. The
	 * measure needs a surrogate that predicts an interval; for another surrogate, or an empty
	 * data set, it is undefined and is not written (a warning is logged).
	 */
	def void picp();

	/**
	 * Calculates the <i>mean prediction interval width</i> of every output feature on the
	 * assessed data set (the training data while learning, the test data while testing;
	 * Khosravi, Nahavandi, Creighton and Atiya 2011, https://doi.org/10.1109/TNN.2011.2162110):
	 *
	 * <math display="block">
	 *   <mrow>
	 *     <mi>m</mi><mi>p</mi><mi>i</mi><mi>w</mi>
	 *     <mo>=</mo>
	 *     <mfrac>
	 *       <mn>1</mn>
	 *       <mi>n</mi>
	 *     </mfrac>
	 *     <msubsup>
	 *       <mo stretchy="true">∑</mo>
	 *       <mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow>
	 *       <mi>n</mi>
	 *     </msubsup>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <msub><mi>U</mi><mi>i</mi></msub>
	 *     <mo>−</mo>
	 *     <msub><mi>L</mi><mi>i</mi></msub>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *   </mrow>
	 * </math>
	 *
	 * with the symbols of {@code picp}, in the unit of the output. Together with {@code picp} it
	 * shows whether an interval holds the data because it is informative or only because it is
	 * wide. The measure needs a surrogate that predicts an interval; for another surrogate, or an
	 * empty data set, it is undefined and is not written (a warning is logged).
	 */
	def void mpiw();
}
