import "definitions" from 'de.evoal.core.constraints';
import "definitions" from 'de.evoal.core.base';
import "definitions" from de.evoal.optimisation.core;

module de.evoal.optimisation.ea.optimisation {
    /**
     * What happens to a gene value outside the boundaries of its feature after a
     *   recombination or mutation.
     *   wrap:   the value enters the range from the other side (periodic boundaries).
     *   bounce: the value is reflected at the boundary, as often as needed.
     *   stick:  the value is set to the nearest boundary.
     */
    nominal enum 'boundary-handling' ( wrap, bounce, stick );

    /**
     * An evolutionary algorithm (EA) on tabular search spaces and on models (structured data,
     *   see 'model-chromosome'). Every generation:
     *
     * <ol>
     *   <li>the 'parent-selection' selects 2 * ceil(n / 2) parents of the population
     *     ('number-of-offspring' n); consecutive parents form a pair,</li>
     *   <li>the recombinations of the chromosomes recombine every pair into two children; a
     *     pair that is not recombined passes on two copies,</li>
     *   <li>the mutations of the chromosomes mutate the first n children,</li>
     *   <li>the 'candidate-checks' of new candidates test the children,</li>
     *   <li>the children are evaluated; unchanged copies keep the evaluation of their
     *     parent,</li>
     *   <li>the 'replacement' forms the next population of 'size-of-population'
     *     candidates,</li>
     *   <li>the 'candidate-checks' of the population test it.</li>
     * </ol>
     *
     * Every search variable that is not boolean or structured needs a lower and an upper
     *   boundary.
     */
    @RequiresBoundaries { lower := true; upper := true; features := path "/algorithm/problem/searchSpace"; }
    type 'evolutionary-algorithm' extends algorithm {
        /**
         * The number of candidates in the population (N).
         */
        @LowerBoundary { boundary := 1; }
        'size-of-population' : int;

        /**
         * The number of children per generation (lambda).
         */
        @LowerBoundary { boundary := 1; }
        'number-of-offspring' : int;

        /**
         * How the features are mapped to chromosomes; every chromosome lists its
         *   recombinations and mutations.
         */
        genotype : instance genotype;

        /**
         * Selects the parents from the population.
         */
        'parent-selection' : instance selection;

        /**
         * Forms the next population from the parents and the children.
         */
        replacement : instance replacement;

        /**
         * What happens to gene values outside the boundaries of their feature.
         */
        'boundary-handling' : enum 'boundary-handling' := 'boundary-handling.stick';
    }

    /**
     * Maps the features to chromosomes. Every search variable belongs to exactly one
     *   chromosome.
     */
    type genotype {
        @MinimumNumberOfElements { bound := 1; }
        chromosomes : array instance chromosome;
    }

    /**
     * Abstract base type of the chromosomes. A chromosome lists its recombinations and
     *   mutations. Its type is the representation of its genes ('double-chromosome',
     *   'integer-chromosome', 'bit-chromosome', 'gray-chromosome', 'model-chromosome'). An operator states the
     *   chromosomes it applies to with @Requires on the type of its chromosome, e.g.
     *   path "(..)+[double-chromosome]", and the weakest scale of the features with
     *   @RequiresScale on path "(..)+[chromosome]/features"; an operator of a chromosome that
     *   it does not apply to is rejected when the configuration is loaded. A chromosome with
     *   neither recombinations nor mutations never changes, which is reported as a warning
     *   when the algorithm starts.
     */
    abstract type chromosome {
        /**
         * The features of the chromosome, in the order of its genes.
         */
        @MinimumNumberOfElements { bound := 1; }
        features : array data;

        /**
         * The recombinations of the chromosome, in their order; empty if the chromosome is
         *   not recombined.
         */
        recombination : array instance recombination;

        /**
         * The mutations of the chromosome, in their order; empty if the chromosome is not
         *   mutated.
         */
        mutation : array instance mutation;
    }

    /**
     * Real features, one gene each.
     */
    @RequiresRepresentation { representations := ['representation.real']; features := path "features"; }
    type 'double-chromosome' extends chromosome {}

    /**
     * Integer features, one gene each.
     */
    @RequiresRepresentation { representations := ['representation.integer']; features := path "features"; }
    type 'integer-chromosome' extends chromosome {}

    /**
     * Features as bits in standard binary code: a boolean feature is one bit, a real or
     *   integer feature 'precision' bits. The bits k of a feature with the boundaries l
     *   and u stand for l + k * (u - l) / (2^precision - 1); integers are rounded, and
     *   every integer of the range must be reachable.
     */
    @RequiresRepresentation { representations := ['representation.real', 'representation.integer', 'representation.boolean'];
                              features := path "features"; }
    type 'bit-chromosome' extends chromosome {
        /**
         * The number of bits of a real or integer feature.
         */
        @LowerBoundary { boundary := 1; }
        @UpperBoundary { boundary := 52; }
        precision : int := 16;
    }

    /**
     * Like 'bit-chromosome', but real and integer features are in Gray code, so
     *   neighbouring values differ in one bit (reflected binary code, Gray 1953).
     */
    @Literature { keys := ["gray1953pulse"]; }
    @RequiresRepresentation { representations := ['representation.real', 'representation.integer', 'representation.boolean'];
                              features := path "features"; }
    type 'gray-chromosome' extends chromosome {
        /**
         * The number of bits of a real or integer feature.
         */
        @LowerBoundary { boundary := 1; }
        @UpperBoundary { boundary := 52; }
        precision : int := 16;
    }

    /**
     * Structured data (models, 'data 'x' of instance T'), one gene each: the tree of objects of
     *   the model. A genotype may combine it with the other chromosomes. The value mutations
     *   ('random-reset-mutation', 'gaussian-mutation', 'polynomial-mutation', 'creep-mutation',
     *   'bit-flip-mutation') change the attribute values of the models: the objects in pre-order
     *   (the root, then the contained objects in the order of the attributes and their elements),
     *   per object its attributes in their order, one gene per element of an array; an optional
     *   attribute without value is no gene. Each mutation changes only the attributes of the
     *   types and scales it applies to (an attribute without @Scale is nominal), and the default
     *   'gene-probability' 1 / n counts these values of the child. The structural operators
     *   ('subtree-crossover', 'subtree-mutation', 'array-size-mutation',
     *   'array-reorder-mutation') change the trees; plugins can add their own. The gene-exchange
     *   recombinations exchange whole models if the chromosome has several features.
     *
     * The models must be buildable as for 'random-population', and every int and real attribute
     *   of their types needs a lower and an upper boundary; the 'boundary-handling' keeps the
     *   values within them. The operators keep no size or depth limit: 'maximum-size' and
     *   'maximum-depth' check the candidates.
     */
    type 'model-chromosome' extends chromosome {}

    /**
     * Abstract base type of the recombinations. A recombination of a chromosome is applied
     *   to a pair of parents with 'probability' (one draw per pair) and then changes the
     *   chromosome. It creates two children.
     */
    abstract type recombination extends configuration {
        /**
         * The probability that the recombination is applied to a pair.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        probability : real := 1.0;
    }

    /**
     * Abstract base type of the mutations. A mutation of a chromosome is applied to a child
     *   with 'probability' (one draw per child) and then changes every gene of the
     *   chromosome with 'gene-probability' (one draw per gene).
     */
    @Literature { keys := ["muehlenbein1992how", "baeck1993optimal"]; }
    abstract type mutation extends configuration {
        /**
         * The probability that the mutation is applied to a child.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        probability : real := 1.0;

        /**
         * The probability that a gene is changed. If it is not set, it is 1 / n, where n
         *   is the number of genes of the chromosome, the usual rate of one changed gene
         *   per mutation (Muehlenbein 1992; Baeck 1993).
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        'gene-probability' : optional real;
    }

    /**
     * Abstract base type of the recombinations that only exchange genes between the two
     *   children, so every gene of a child comes from one of the parents. Blending
     *   recombinations, which create new values (e.g. 'sbx-crossover'), are no gene exchange.
     *   'linkage-crossover' wraps a gene exchange.
     */
    abstract type 'gene-exchange' extends recombination {}

    /**
     * One-point crossover: a cut point is chosen uniformly between two
     *   genes, and the children exchange the genes after it.
     */
    type 'single-point-crossover' extends 'gene-exchange' {}

    /**
     * Multi-point crossover: 'points' different cut points are chosen
     *   uniformly between two genes, and the children exchange every second segment.
     */
    type 'multi-point-crossover' extends 'gene-exchange' {
        /**
         * The number of cut points; at most the number of genes minus 1.
         */
        @LowerBoundary { boundary := 1; }
        points : int := 2;
    }

    /**
     * Uniform crossover (Syswerda 1989): the children exchange every gene with
     *   'swap-probability'.
     */
    @Literature { keys := ["syswerda1989uniform"]; }
    type 'uniform-crossover' extends 'gene-exchange' {
        /**
         * The probability that a gene is exchanged.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        'swap-probability' : real := 0.5;
    }

    /**
     * Simulated binary crossover (SBX; Deb and Agrawal 1995) in the bounded form of the
     *   NSGA-II reference implementation, revision 1.1.6 (Deb et al. 2002): the
     *   children of two parent values are spread around them with the spread factor of
     *   the polynomial distribution with 'distribution-index'; a larger index keeps the
     *   children closer to the parents. Every gene is recombined with probability 0.5.
     */
    @Requires { selection := path "(..)+[double-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "(..)+[chromosome]/features"; }
    @Literature { keys := ["deb1995simulated", "deb2002fast"]; }
    type 'sbx-crossover' extends recombination {
        /**
         * The distribution index (eta_c).
         */
        @LowerBoundary { boundary := 0.0; }
        'distribution-index' : real := 15.0;
    }

    /**
     * Line recombination (the extended line recombination of the breeder genetic
     *   algorithm, Muehlenbein and Schlierkamp-Voosen 1993): every child lies on the line
     *   through its parents, z = x + a (y - x), where x is the parent whose place it takes,
     *   y the other parent, and a is drawn uniformly from [-d, 1 + d] (d = 'extension'),
     *   once per child and chromosome.
     */
    @Requires { selection := path "(..)+[double-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "(..)+[chromosome]/features"; }
    @Literature { keys := ["muehlenbein1993predictive"]; }
    type 'line-crossover' extends recombination {
        /**
         * How far a child may lie beyond its parents, relative to their distance (d).
         */
        @LowerBoundary { boundary := 0.0; }
        extension : real := 0.25;
    }

    /**
     * Arithmetic crossover: the children are the weighted means alpha x + (1 - alpha) y
     *   and (1 - alpha) x + alpha y of the parents x and y, gene by gene; x is the parent
     *   whose place the first child takes. With alpha = 0.5 both children are the mean of
     *   the parents.
     */
    @Requires { selection := path "(..)+[double-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "(..)+[chromosome]/features"; }
    type 'arithmetic-crossover' extends recombination {
        /**
         * The weight of the parent whose place a child takes.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        alpha : real := 0.5;
    }

    /**
     * Blend crossover BLX-alpha (Eshelman and Schaffer 1993): every gene of every child is
     *   drawn uniformly from [min - alpha I, max + alpha I], where min and max are the
     *   parent values and I = max - min.
     */
    @Requires { selection := path "(..)+[double-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "(..)+[chromosome]/features"; }
    @Literature { keys := ["eshelman1993real"]; }
    type 'blx-alpha-crossover' extends recombination {
        /**
         * How far the interval reaches beyond the parents, relative to their distance.
         */
        @LowerBoundary { boundary := 0.0; }
        alpha : real := 0.5;
    }

    /**
     * Random reset mutation: a mutated gene gets a value drawn uniformly from the
     *   boundaries of its feature. On a 'model-chromosome' it changes every boolean, int, real
     *   and enum attribute, drawn as by 'random-population'.
     */
    @Requires { selection := path "(..)+[double-chromosome] | (..)+[integer-chromosome] | (..)+[model-chromosome]"; }
    type 'random-reset-mutation' extends mutation {}

    /**
     * Gaussian mutation: a normally distributed value with mean 0 and the standard
     *   deviation 'sigma' times the range of the feature is added to a mutated gene. On a
     *   'model-chromosome' it changes the real attributes of at least cardinal scale.
     */
    @Requires { selection := path "(..)+[double-chromosome] | (..)+[model-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "(..)+[chromosome]/features"; }
    type 'gaussian-mutation' extends mutation {
        /**
         * The standard deviation relative to the range of the feature.
         */
        @LowerBoundary { boundary := 0.0; inclusive := false; }
        sigma : real := 0.1;
    }

    /**
     * Bit-flip mutation: a mutated bit is inverted. On a 'model-chromosome' it inverts the
     *   boolean attributes.
     */
    @Requires { selection := path "(..)+[bit-chromosome] | (..)+[gray-chromosome] | (..)+[model-chromosome]"; }
    type 'bit-flip-mutation' extends mutation {}

    /**
     * Polynomial mutation in the bounded form of the NSGA-II reference implementation,
     *   revision 1.1.6 (Deb et al. 2002): a mutated gene is moved
     *   by a perturbation of the polynomial distribution with 'distribution-index'; a
     *   larger index gives smaller changes. On a 'model-chromosome' it changes the real
     *   attributes of at least cardinal scale.
     */
    @Requires { selection := path "(..)+[double-chromosome] | (..)+[model-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "(..)+[chromosome]/features"; }
    @Literature { keys := ["deb2002fast"]; }
    type 'polynomial-mutation' extends mutation {
        /**
         * The distribution index (eta_m).
         */
        @LowerBoundary { boundary := 0.0; }
        'distribution-index' : real := 20.0;
    }

    /**
     * Creep mutation: a mutated gene changes by a value drawn uniformly from -step, ...,
     *   -1, 1, ..., step. On a 'model-chromosome' it changes the int and enum attributes of at
     *   least ordinal scale; an enum value moves by the change in the order of its literals,
     *   and the 'boundary-handling' keeps it among them.
     */
    @Requires { selection := path "(..)+[integer-chromosome] | (..)+[model-chromosome]"; }
    @RequiresScale { minimum := 'measurement-scale.ordinal'; features := path "(..)+[chromosome]/features"; }
    type 'creep-mutation' extends mutation {
        /**
         * The largest change of a gene.
         */
        @LowerBoundary { boundary := 1; }
        step : int := 1;
    }

    /**
     * Subtree crossover: the two children exchange a subtree of every model (Koza 1992; Poli,
     *   Langdon and McPhee 2008, sec. 2.4, in the variant with two offspring), restricted to
     *   subtrees of fitting types as in strongly typed genetic programming (Montana 1995, sec.
     *   2.1). Montana's second subtree returns the same type as the first; a model has subtypes,
     *   so here each node fits the place of the other, i.e. its type is the type of the other's
     *   attribute or one of its subtypes. A node of the first child is drawn among the nodes that
     *   have such a partner in the second child (Montana draws it among all nodes and returns
     *   the parents if it has none), then its partner. The roots are not exchanged. The subtrees
     *   take each other's positions, so the number of elements of every array stays; a model
     *   without a fitting pair stays unchanged.
     */
    @Requires { selection := path "(..)+[model-chromosome]"; }
    @Literature { keys := ["koza1992genetic", "poli2008field", "montana1995strongly"]; }
    type 'subtree-crossover' extends recombination {
        /**
         * The probability that a node is drawn among the inner nodes (objects that contain
         *   objects) instead of the leaves; uniform among all nodes if it is not set. Koza
         *   (1992) used 0.9.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        'internal-node-probability' : optional real;
    }

    /**
     * Subtree mutation: a node of every model, the root included, is replaced by a new random
     *   tree of the type of its place, built with 'method' (Poli, Langdon and McPhee 2008,
     *   sec. 2.4; typed as in Montana 1995, sec. 2.1). The depth limit of the method counts from the root of the model, its
     *   'maximum-size' limits the whole model. The mutation changes every model once, so it has
     *   no 'gene-probability'.
     */
    @Requires { selection := path "(..)+[model-chromosome]"; }
    @Literature { keys := ["koza1992genetic", "poli2008field", "montana1995strongly"]; }
    type 'subtree-mutation' extends mutation {
        /**
         * How the new subtrees are built; its plans are used in turn, one per subtree.
         */
        method : instance 'tree-method';

        /**
         * The probability that the node is drawn among the inner nodes instead of the leaves;
         *   uniform among all nodes if it is not set.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        'internal-node-probability' : optional real;
    }

    /**
     * Array size mutation: an array of every model whose number of elements can change is
     *   chosen uniformly and gets one element more or less: at its @MinimumNumberOfElements one
     *   more, at its @MaximumNumberOfElements one less, otherwise each with probability 1/2. A
     *   new element is inserted at a uniformly drawn position, as a value drawn as by
     *   'random-population' or as a new tree built with 'method'; a uniformly drawn element is
     *   removed. The mutation changes every model once, so it has no 'gene-probability'.
     */
    @Requires { selection := path "(..)+[model-chromosome]"; }
    type 'array-size-mutation' extends mutation {
        /**
         * How new elements of arrays of objects are built; required if the models have such
         *   arrays whose size can change.
         */
        method : optional instance 'tree-method';
    }

    /**
     * Array reorder mutation: an array of every model with at least two elements is chosen
     *   uniformly, and the elements at two different, uniformly drawn positions are exchanged.
     *   The mutation changes every model once, so it has no 'gene-probability'.
     */
    @Requires { selection := path "(..)+[model-chromosome]"; }
    type 'array-reorder-mutation' extends mutation {}

    /**
     * Single-choice mutation (specific to EvoAl): if it fires ('probability', one draw per
     *   child), exactly one of its 'children' is chosen with the given 'weights' and
     *   applied with its own 'gene-probability'; the 'probability' of the chosen mutation is
     *   not used. Its own 'gene-probability' is not used either. It applies to a
     *   chromosome that all its children apply to.
     */
    @Literature { keys := ["berger2024evoal"]; }
    type 'single-choice-mutation' extends mutation {
        /**
         * The mutations to choose from.
         */
        @MinimumNumberOfElements { bound := 1; }
        children : array instance mutation;

        /**
         * The weight of every child, in their order: one weight per child, not negative,
         *   at least one greater than 0.
         */
        weights : array real;
    }

    /**
     * Correlation-aware mutation (specific to EvoAl): the wrapped 'mutation' makes the
     *   primary change; its 'probability', 'gene-probability' and applicability are used, the
     *   own ones are not. Afterwards, the change of every feature f is propagated to the
     *   features g correlated with it in the DDL ('correlation', 'ranged-correlation'),
     *   regardless of their chromosome and representation:
     *   change(g) = rho * change(f) / range(f) * range(g). The range of a feature is given
     *   by its bounds in the DDL (an integer feature without bounds uses the range of its
     *   type; a pair with an unbounded real feature is skipped). For a pair with an ordinal feature, the
     *   shift is applied to the normalised rank; pairs with a nominal feature are skipped.
     *   The new value is rounded for integer features and clamped to the bounds. A ranged
     *   correlation applies only if both features lie in their ranges.
     *
     * The propagation is deterministic: the correlations are visited in the order of the
     *   DDL, a feature with several changed partners takes the change of the first one, and
     *   every feature changes at most once per mutation; the features the wrapped mutation
     *   changed are not changed again. The relationship of the child records the properties
     *   'primary-features' and 'propagated-features'.
     */
    @Literature { keys := ["berger2024evoal"]; }
    type 'correlation-aware-mutation' extends mutation {
        /**
         * The mutation that makes the primary change.
         */
        mutation : instance mutation;

        /**
         * The smallest absolute correlation coefficient that is propagated.
         */
        @LowerBoundary { boundary := 0.0; inclusive := true; }
        @UpperBoundary { boundary := 1.0; inclusive := true; }
        'minimum-correlation' : real := 0.0;

        /**
         * The number of propagation steps: 1 propagates only to the features correlated with
         *   a changed feature, n follows chains of up to n correlations.
         */
        @LowerBoundary { boundary := 1; }
        'propagation-depth' : int := 1;
    }

    /**
     * Linkage crossover (specific to EvoAl): the wrapped 'crossover' exchanges the genes;
     *   its 'probability' and applicability are used, the own ones are not. Afterwards,
     *   the features of every building block and of every correlated pair of the DDL are
     *   inherited from the same parent, regardless of their chromosome and representation:
     *   for every building block and correlation, in the order of the DDL, a feature that a
     *   child inherited from one parent (the anchor) determines that the child gets the
     *   other features from this parent, and its sibling from the other parent. A feature
     *   that an earlier building block or correlation already set stays as it is and serves
     *   as the anchor, so every feature is set at most once and overlapping building blocks
     *   are possible. A ranged correlation applies if the values of both parents lie in its
     *   ranges. The linkage of a group of genes is the probability that the crossover
     *   conserves it (Harik and Goldberg 1997, section 2); the operator conserves every group
     *   whose anchor comes from one parent. The relationships of the children record the
     *   property 'linked-features'.
     */
    @Literature { keys := ["berger2024evoal", "harik1997learning"]; }
    type 'linkage-crossover' extends recombination {
        /**
         * The crossover that exchanges the genes: 'single-point-crossover',
         *   'multi-point-crossover' or 'uniform-crossover'.
         */
        crossover : instance 'gene-exchange';

        /**
         * The smallest absolute correlation coefficient whose features are kept together;
         *   building blocks are always kept together.
         */
        @LowerBoundary { boundary := 0.0; inclusive := true; }
        @UpperBoundary { boundary := 1.0; inclusive := true; }
        'minimum-correlation' : real := 0.0;
    }

    /**
     * Writes how often the recombinations of every iteration preserve the building blocks
     *   and correlated pairs of the DDL. The linkage of a building block is the probability
     *   that crossover preserves it (Harik and Goldberg 1997, section 2); the rates estimate
     *   it.
     *
     * Every child that a recombination created is counted for every building block and
     *   correlation that applies to its parents (a ranged correlation only if both parents
     *   lie in its ranges). A group is preserved in a child if all its features have the
     *   values of one parent. It is checked at the end of the recombinations, before the
     *   mutation, and right before the first linkage step of the pair: with a single
     *   'linkage-crossover', the latter is the wrapped crossover alone; with several
     *   recombinations, later ones only show in the first value. Without a linkage step,
     *   both are the same.
     *
     * The evolutionary algorithm records the counts as iteration metrics of the memory
     *   model ('linkage-children-g', 'linkage-preserved-g', 'linkage-preserved-before-g').
     *   File: <tt>linkage-statistics.csv</tt> in the output folder, one row per iteration:
     *   <tt>iteration</tt>, then for every building block and correlation g of the DDL
     *   (<tt>building-block-n</tt>, <tt>correlation-n</tt>), in its order:
     *   <tt>children-g</tt>, <tt>preserved-g</tt>, <tt>rate-g</tt>,
     *   <tt>preserved-before-g</tt> and <tt>rate-before-g</tt>. A rate is empty if no child
     *   was counted.
     *
     * A problem without building blocks and correlations is rejected.
     */
    @Literature { keys := ["berger2024evoal", "harik1997learning"]; }
    type 'linkage-statistics' extends 'statistics-writer' {}

    /**
     * Abstract base type of the selections. A selection chooses a number of candidates
     *   from a list; a candidate can be chosen more than once. The selections compare by
     *   the 'comparator' of the algorithm, except the ones that use the fitness itself.
     */
    abstract type selection extends configuration {}

    /**
     * Tournament selection (analysed by Goldberg and Deb 1991): every selected candidate is
     *   the best of 'size'
     *   candidates drawn uniformly with replacement.
     */
    @Literature { keys := ["goldberg1991comparative"]; }
    type 'tournament-selection' extends selection {
        /**
         * The number of candidates in a tournament.
         */
        @LowerBoundary { boundary := 1; }
        size : int := 2;
    }

    /**
     * Elitism: the 'count' best candidates are selected first, the
     *   remaining ones by 'rest' from all candidates. The result starts with the best
     *   candidates in their order, so as 'parent-selection' the best candidates are paired
     *   with each other.
     */
    type 'elite-selection' extends selection {
        /**
         * The number of best candidates that are always selected.
         */
        @LowerBoundary { boundary := 0; }
        count : int;

        /**
         * Selects the remaining candidates.
         */
        rest : instance selection;
    }

    /**
     * Truncation selection (Muehlenbein and Schlierkamp-Voosen 1993): every selected
     *   candidate is drawn uniformly from the best ceil('threshold' * n) of the n
     *   candidates.
     */
    @Literature { keys := ["muehlenbein1993predictive"]; }
    type 'truncation-selection' extends selection {
        /**
         * The fraction of the candidates that can be selected.
         */
        @LowerBoundary { boundary := 0.0; inclusive := false; }
        @UpperBoundary { boundary := 1.0; }
        threshold : real;
    }

    /**
     * Random selection: every selected candidate is drawn uniformly.
     */
    type 'random-selection' extends selection {}

    /**
     * Linear ranking selection (ranking selection: Baker 1985): the candidates are ranked
     *   from the worst
     *   (rank 1) to the best (rank n); a candidate of rank i is selected with probability
     *   (eta- + (eta+ - eta-) (i - 1) / (n - 1)) / n with eta+ = 2 - eta-.
     */
    @Literature { keys := ["baker1985adaptive"]; }
    type 'linear-ranking-selection' extends selection {
        /**
         * The expected number of selections of the worst candidate per n selections.
         */
        @LowerBoundary { boundary := 0.0; }
        @UpperBoundary { boundary := 1.0; }
        'eta-minus' : real;
    }

    /**
     * Exponential ranking selection (analysed by Blickle and Thiele 1996): the candidates are
     *   ranked from the worst (rank 1) to the best (rank n); a candidate of rank i is selected
     *   with a probability proportional to c^(n - i). c = 1 selects uniformly.
     */
    @Literature { keys := ["blickle1996comparison"]; }
    type 'exponential-ranking-selection' extends selection {
        /**
         * The base of the probabilities.
         */
        @LowerBoundary { boundary := 0.0; inclusive := false; }
        @UpperBoundary { boundary := 1.0; }
        'c' : real;
    }

    /**
     * Roulette wheel selection, fitness-proportional for minimisation
     *   with windowing: a candidate with fitness f is selected with a probability
     *   proportional to f_max - f, where f_max is the largest finite fitness of the
     *   candidates. If all have the same fitness, it selects uniformly. A fitness of
     *   Infinity (worst) is not selected while another candidate has a finite fitness; if a
     *   fitness is -Infinity (best), only the candidates with -Infinity are selected; NaN is
     *   an error. Needs a fitness with one component.
     */
    @RequiresFitnessComponents { minimum := 1; maximum := 1; }
    type 'roulette-wheel-selection' extends selection {}

    /**
     * Stochastic universal sampling (Baker 1987): the probabilities of the roulette wheel
     *   selection, but all candidates are selected with one spin and equally spaced
     *   pointers, so a candidate is selected floor or ceil of its expected number of
     *   times. The selected candidates are returned in random order, so as
     *   'parent-selection' the pairs are random. Infinite fitness and NaN as in the
     *   roulette wheel selection. Needs a fitness with one component.
     */
    @Literature { keys := ["baker1987reducing"]; }
    @RequiresFitnessComponents { minimum := 1; maximum := 1; }
    type 'stochastic-universal-sampling' extends selection {}

    /**
     * Boltzmann selection: a candidate with fitness f is selected with a probability
     *   proportional to exp(-(f - f_min) / temperature), where f_min is the smallest
     *   finite fitness of the candidates. Infinite fitness and NaN as in the roulette
     *   wheel selection. Needs a fitness with one component.
     */
    @RequiresFitnessComponents { minimum := 1; maximum := 1; }
    type 'boltzmann-selection' extends selection {
        /**
         * The temperature; a larger temperature selects more uniformly.
         */
        @LowerBoundary { boundary := 0.0; inclusive := false; }
        temperature : real;
    }

    /**
     * The survivor selection of NSGA-II (Deb et al. 2002): the candidates are sorted into
     *   non-dominated fronts on the canonical fitness (all components minimised), and the
     *   crowding distance is computed in every front. The fronts are selected in their order;
     *   of the first front that does not fit completely, the candidates with the largest
     *   crowding distance are selected. Unlike the other selections, it selects without
     *   replacement. Every candidate gets the properties 'front' and 'crowding-distance'.
     *   Needs 'crowded-comparator', a fitness with at least two components, and
     *   'plus-replacement' (NSGA-II) or 'comma-replacement'.
     *
     *   With a constraint group, the sorting uses constrained domination (ibid., section
     *   VI-A, Definition 1): a feasible candidate dominates an infeasible one, of two
     *   infeasible candidates the one with the smaller violation of the group dominates,
     *   and two feasible candidates are compared by Pareto dominance. 'crowded-comparator'
     *   then compares by constrained domination, too.
     */
    @Literature { keys := ["deb2002fast"]; }
    @RequiresFitnessComponents { minimum := 2; }
    type 'nsga2-selection' extends selection {
        /**
         * The constraint group of the constrained domination, as named in the DDL.
         */
        group : optional string;
    }

    /**
     * How 'stochastic-ranking-selection' measures the penalty of a candidate from its
     *   violation of the group.
     *   sum:           the violation of the group, the sum of the degrees of its constraints,
     *                  as the other constraint handlings measure it.
     *   'squared-sum': the sum of the squared degrees, the quadratic loss of the paper (eq. 5).
     */
    nominal enum 'stochastic-ranking-penalty' ( sum, 'squared-sum' );

    /**
     * Stochastic ranking (Runarsson and Yao 2000, Fig. 1): ranks the candidates by sweeps over neighbouring pairs, as in a
     *   bubble sort, and selects the first ones of the ranking, without replacement. The
     *   candidates start in a random order. For every pair, u is drawn from U(0, 1); if both
     *   are feasible in the group or u < 'fitness-probability', the pair is swapped if the
     *   first one has the larger canonical fitness, otherwise if it has the larger penalty.
     *   The ranking stops after a sweep without swap or after 'sweeps' sweeps. The method
     *   balances objective and penalty with one probability instead of a penalty weight; its
     *   comparisons are random, so it cannot be a comparator.
     *
     * In the paper, a (mu, lambda) evolution strategy keeps the first mu of lambda children:
     *   'comma-replacement' { selection := 'stochastic-ranking-selection' { group := "g"; }; }.
     *   The selection does not use the 'comparator' of the algorithm and needs a fitness with
     *   one component. Every ranked candidate gets the property 'stochastic-rank' (its place,
     *   0 for the first; a later ranking in the same iteration overwrites it), and every
     *   iteration the metrics 'stochastic-ranking-sweeps', 'stochastic-ranking-fitness-comparisons'
     *   and 'stochastic-ranking-penalty-comparisons' (comparisons of pairs with at least one
     *   infeasible candidate that the fitness or the penalty decided; summed over the rankings
     *   of the iteration).
     */
    @Literature { keys := ["runarsson2000stochastic"]; }
    @RequiresFitnessComponents { minimum := 1; maximum := 1; }
    type 'stochastic-ranking-selection' extends selection {
        /**
         * The constraint group, as named in the DDL.
         */
        group : string;

        /**
         * The probability P_f that two neighbours, at least one of them infeasible, are
         *   compared by their fitness. 0 ranks by feasibility first, 1 ignores the
         *   constraints; the paper recommends a value below 0.5 and uses 0.45.
         */
        @LowerBoundary { boundary := 0.0; inclusive := true; }
        @UpperBoundary { boundary := 1.0; inclusive := true; }
        'fitness-probability' : real := 0.45;

        /**
         * The maximum number of sweeps N. If it is not set, it is the number of ranked
         *   candidates, as in the paper (N = lambda): as survivor selection of a
         *   'plus-replacement' N + lambda, of a 'comma-replacement' lambda, as parent selection
         *   the size of the population.
         */
        @LowerBoundary { boundary := 1; }
        sweeps : optional int;

        /**
         * How the penalty of a candidate is measured.
         */
        penalty : enum 'stochastic-ranking-penalty' := 'stochastic-ranking-penalty.squared-sum';
    }

    /**
     * Abstract base type of the replacements: they form the next population of N
     *   candidates ('size-of-population') from the N parents of the population and the
     *   lambda children ('number-of-offspring').
     */
    abstract type replacement extends configuration {
        /**
         * Selects the candidates that survive.
         */
        selection : instance selection;
    }

    /**
     * N - lambda survivors are selected from the parents, and all lambda children
     *   survive. Needs lambda <= N.
     */
    type 'survivor-replacement' extends replacement {}

    /**
     * N candidates are selected from the parents and the children together, the
     *   (mu + lambda) strategy (Schwefel 1977).
     */
    @Literature { keys := ["schwefel1977numerische"]; }
    type 'plus-replacement' extends replacement {}

    /**
     * N candidates are selected from the children only, the (mu, lambda) strategy
     *   (Schwefel 1977). Needs lambda >= N.
     */
    @Literature { keys := ["schwefel1977numerische"]; }
    type 'comma-replacement' extends replacement {}

    /**
     * The comparator of NSGA-II (Deb et al. 2002): the selections of the algorithm compare
     *   candidates by the crowded-comparison operator: a lower front is better, and in the
     *   same front a larger crowding distance. Front and crowding distance are computed by
     *   'nsga2-selection', which must be the selection of the replacement. With
     *   'tournament-selection' { size := 2; } as 'parent-selection', it gives the parent
     *   selection of NSGA-II; on equal front and crowding distance the first drawn candidate
     *   wins, while the reference implementation chooses at random. Elsewhere (e.g. for the
     *   best candidate so far), candidates are compared by Pareto dominance. Only the
     *   evolutionary algorithm can use it.
     */
    @Literature { keys := ["deb2002fast"]; }
    type 'crowded-comparator' extends comparator {}
}
