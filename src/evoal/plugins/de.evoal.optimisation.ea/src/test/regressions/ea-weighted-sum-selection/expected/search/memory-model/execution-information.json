{
  "formatVersion" : "2027.4.0",
  "problem" : {
    "name" : "regression",
    "goals" : [ {
      "feature" : "y:0",
      "direction" : "minimise"
    }, {
      "feature" : "y:1",
      "direction" : "maximise"
    } ],
    "function" : {
      "type" : "de.evoal.pipeline.optimisation.benchmark-function",
      "attributes" : {
        "benchmarks" : [ {
          "type" : "de.evoal.pipeline.optimisation.benchmark-configuration",
          "attributes" : {
            "function" : {
              "type" : "de.evoal.pipeline.benchmarks.rosenbrock",
              "attributes" : { }
            },
            "reads" : [ "x:0", "x:1" ],
            "writes" : [ "y:0" ]
          }
        }, {
          "type" : "de.evoal.pipeline.optimisation.benchmark-configuration",
          "attributes" : {
            "function" : {
              "type" : "de.evoal.pipeline.benchmarks.weighted-sphere",
              "attributes" : { }
            },
            "reads" : [ "x:0", "x:1" ],
            "writes" : [ "y:1" ]
          }
        } ]
      }
    }
  },
  "algorithm" : {
    "type" : "de.evoal.optimisation.ea.optimisation.evolutionary-algorithm",
    "attributes" : {
      "initialisation" : {
        "type" : "de.evoal.optimisation.core.random-population",
        "attributes" : { }
      },
      "optimisation-function" : {
        "type" : "de.evoal.optimisation.core.problem-function",
        "attributes" : { }
      },
      "comparator" : {
        "type" : "de.evoal.optimisation.core.numeric-comparator",
        "attributes" : { }
      },
      "stopping-criteria" : [ {
        "type" : "de.evoal.optimisation.core.iteration-count",
        "attributes" : {
          "maximum-iterations" : 10
        }
      } ],
      "fitness-pipeline" : [ {
        "type" : "de.evoal.optimisation.core.scaling",
        "attributes" : {
          "references" : [ {
            "type" : "de.evoal.optimisation.core.variable",
            "attributes" : {
              "var" : "y:0",
              "val" : 100.0
            }
          } ]
        }
      }, {
        "type" : "de.evoal.optimisation.core.weighted-sum",
        "attributes" : {
          "weights" : [ {
            "type" : "de.evoal.optimisation.core.variable",
            "attributes" : {
              "var" : "y:0",
              "val" : 2.0
            }
          }, {
            "type" : "de.evoal.optimisation.core.variable",
            "attributes" : {
              "var" : "y:1",
              "val" : 1.0
            }
          } ],
          "normalise" : true
        }
      } ],
      "candidate-checks" : [ ],
      "constraint-measure" : {
        "type" : "de.evoal.optimisation.core.exact-measure",
        "attributes" : {
          "equality-tolerance" : 1.0E-4
        }
      },
      "size-of-population" : 20,
      "number-of-offspring" : 10,
      "genotype" : {
        "type" : "de.evoal.optimisation.ea.optimisation.genotype",
        "attributes" : {
          "chromosomes" : [ {
            "type" : "de.evoal.optimisation.ea.optimisation.double-chromosome",
            "attributes" : {
              "features" : [ "x:0", "x:1" ],
              "recombination" : [ {
                "type" : "de.evoal.optimisation.ea.optimisation.uniform-crossover",
                "attributes" : {
                  "probability" : 1.0,
                  "swap-probability" : 0.5
                }
              } ],
              "mutation" : [ {
                "type" : "de.evoal.optimisation.ea.optimisation.gaussian-mutation",
                "attributes" : {
                  "probability" : 1.0,
                  "gene-probability" : null,
                  "sigma" : 0.1
                }
              } ]
            }
          } ]
        }
      },
      "parent-selection" : {
        "type" : "de.evoal.optimisation.ea.optimisation.roulette-wheel-selection",
        "attributes" : { }
      },
      "replacement" : {
        "type" : "de.evoal.optimisation.ea.optimisation.survivor-replacement",
        "attributes" : {
          "selection" : {
            "type" : "de.evoal.optimisation.ea.optimisation.stochastic-universal-sampling",
            "attributes" : { }
          }
        }
      },
      "boundary-handling" : "stick"
    }
  },
  "documentation" : [ {
    "type" : "de.evoal.optimisation.core.best-candidate-per-iteration",
    "attributes" : {
      "prefix-data" : false,
      "store-search-space" : true,
      "store-optimisation-space" : true
    }
  }, {
    "type" : "de.evoal.optimisation.core.memory-model",
    "attributes" : {
      "steps" : false
    }
  } ],
  "citations" : [ "berger2024evoal", "syswerda1989uniform", "muehlenbein1992how", "baeck1993optimal", "baker1987reducing", "rosenbrock1960automatic" ],
  "searchSpace" : [ {
    "name" : "x:0",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  }, {
    "name" : "x:1",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  } ],
  "optimisationSpace" : [ {
    "name" : "y:0",
    "type" : "real",
    "scale" : "quotient"
  }, {
    "name" : "y:1",
    "type" : "real",
    "scale" : "quotient"
  } ],
  "fitness" : {
    "components" : [ {
      "name" : "weighted-sum"
    } ],
    "steps" : [ {
      "type" : "de.evoal.optimisation.core.scaling",
      "attributes" : {
        "references" : [ {
          "type" : "de.evoal.optimisation.core.variable",
          "attributes" : {
            "var" : "y:0",
            "val" : 100.0
          }
        } ]
      }
    }, {
      "type" : "de.evoal.optimisation.core.weighted-sum",
      "attributes" : {
        "weights" : [ {
          "type" : "de.evoal.optimisation.core.variable",
          "attributes" : {
            "var" : "y:0",
            "val" : 2.0
          }
        }, {
          "type" : "de.evoal.optimisation.core.variable",
          "attributes" : {
            "var" : "y:1",
            "val" : 1.0
          }
        } ],
        "normalise" : true
      }
    } ]
  },
  "metricDefinitions" : [ {
    "name" : "evaluations.real",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of evaluations of the real optimisation function."
  }, {
    "name" : "evaluations.surrogate",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of predictions of a surrogate model."
  } ],
  "propertyDefinitions" : [ {
    "name" : "operators",
    "scope" : "relationship",
    "valueType" : "text",
    "list" : true,
    "description" : "The recombinations and mutations that changed the child, in their order."
  }, {
    "name" : "changed-features",
    "scope" : "relationship",
    "valueType" : "text",
    "list" : true,
    "description" : "The features whose genes differ from the parent whose place the child takes."
  } ],
  "setup" : {
    "evoalVersion" : "${evoal.version}",
    "seed" : "42",
    "run" : 0
  }
}
