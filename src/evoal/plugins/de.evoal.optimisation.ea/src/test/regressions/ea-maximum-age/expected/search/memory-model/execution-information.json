{
  "formatVersion" : "2027.4.0",
  "problem" : {
    "name" : "regression",
    "goals" : [ {
      "feature" : "y:0",
      "direction" : "minimise"
    } ],
    "function" : {
      "type" : "de.evoal.pipeline.optimisation.benchmark-function",
      "attributes" : {
        "benchmarks" : [ {
          "type" : "de.evoal.pipeline.optimisation.benchmark-configuration",
          "attributes" : {
            "function" : {
              "type" : "de.evoal.pipeline.benchmarks.rastrigin",
              "attributes" : {
                "a" : 10.0
              }
            },
            "reads" : [ "x:0", "x:1", "x:2" ],
            "writes" : [ "y:0" ]
          }
        } ]
      }
    }
  },
  "algorithm" : {
    "type" : "de.evoal.optimisation.ea.optimisation.evolutionary-algorithm",
    "attributes" : {
      "initialisation" : {
        "type" : "de.evoal.optimisation.core.random-population",
        "attributes" : { }
      },
      "optimisation-function" : {
        "type" : "de.evoal.optimisation.core.problem-function",
        "attributes" : { }
      },
      "comparator" : {
        "type" : "de.evoal.optimisation.core.numeric-comparator",
        "attributes" : { }
      },
      "stopping-criteria" : [ {
        "type" : "de.evoal.optimisation.core.iteration-count",
        "attributes" : {
          "maximum-iterations" : 12
        }
      } ],
      "fitness-pipeline" : [ ],
      "candidate-checks" : [ {
        "type" : "de.evoal.optimisation.core.maximum-age",
        "attributes" : {
          "reaction" : "replace",
          "replacement-source" : null,
          "maximum-attempts" : 10,
          "iterations" : 3
        }
      } ],
      "constraint-measure" : {
        "type" : "de.evoal.optimisation.core.exact-measure",
        "attributes" : {
          "equality-tolerance" : 1.0E-4
        }
      },
      "size-of-population" : 10,
      "number-of-offspring" : 10,
      "genotype" : null,
      "parent-selection" : {
        "type" : "de.evoal.optimisation.ea.optimisation.linear-ranking-selection",
        "attributes" : {
          "eta-minus" : 0.5
        }
      },
      "recombination" : [ ],
      "mutation" : [ ],
      "replacement" : {
        "type" : "de.evoal.optimisation.ea.optimisation.plus-replacement",
        "attributes" : {
          "selection" : {
            "type" : "de.evoal.optimisation.ea.optimisation.elite-selection",
            "attributes" : {
              "count" : 2,
              "rest" : {
                "type" : "de.evoal.optimisation.ea.optimisation.truncation-selection",
                "attributes" : {
                  "threshold" : 0.5
                }
              }
            }
          }
        }
      },
      "boundary-handling" : "stick"
    }
  },
  "documentation" : [ {
    "type" : "de.evoal.optimisation.core.candidates-per-iteration",
    "attributes" : {
      "prefix-data" : false,
      "store-search-space" : true,
      "store-optimisation-space" : true
    }
  }, {
    "type" : "de.evoal.optimisation.core.best-candidate-so-far",
    "attributes" : {
      "prefix-data" : false,
      "store-search-space" : true,
      "store-optimisation-space" : true
    }
  }, {
    "type" : "de.evoal.optimisation.core.memory-model",
    "attributes" : {
      "steps" : true
    }
  } ],
  "searchSpace" : [ {
    "name" : "x:0",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  }, {
    "name" : "x:1",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  }, {
    "name" : "x:2",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  } ],
  "optimisationSpace" : [ {
    "name" : "y:0",
    "type" : "real",
    "scale" : "quotient"
  } ],
  "fitness" : {
    "components" : [ {
      "name" : "y:0",
      "goal" : "y:0"
    } ],
    "steps" : [ ]
  },
  "metricDefinitions" : [ {
    "name" : "evaluations.real",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of evaluations of the real optimisation function."
  }, {
    "name" : "evaluations.surrogate",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of predictions of a surrogate model."
  } ],
  "propertyDefinitions" : [ {
    "name" : "reason",
    "scope" : "relationship",
    "valueType" : "text",
    "list" : false,
    "description" : "Why the target of a replacement failed a candidate check."
  }, {
    "name" : "reason",
    "scope" : "individual",
    "valueType" : "text",
    "list" : false,
    "description" : "Why the candidate this individual replaced failed a candidate check; set if the replaced candidate is not recorded."
  }, {
    "name" : "operators",
    "scope" : "relationship",
    "valueType" : "text",
    "list" : true,
    "description" : "The recombinations and mutations that changed the child, in their order."
  }, {
    "name" : "changed-features",
    "scope" : "relationship",
    "valueType" : "text",
    "list" : true,
    "description" : "The features whose genes differ from the parent whose place the child takes."
  } ],
  "setup" : {
    "evoalVersion" : "${evoal.version}",
    "seed" : "42",
    "run" : 0
  }
}
