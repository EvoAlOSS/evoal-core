import "definitions" from de.evoal.core.math;
import "definitions" from 'de.evoal.pipeline.base';
import "definitions" from 'de.evoal.pipeline.benchmarks';
import "definitions" from 'de.evoal.pipeline.misc';
import "definitions" from 'de.evoal.pipeline.sequences';

import "data" from surrogate;

module 'training-data' {
	/**
	 * The grid x:0 = 0.00, 0.01, ..., 1.00.
	 */
	pipeline 'grid' [
		step {
			component 'sequence-generator' {
				sequences := [
					'expression-based-sequence' {
						variable     := data 'k';
						initial      := 0.0;
						'expression' := data 'k' + 1.0;
					},
					'expression-based-sequence' {
						variable     := data 'x:0';
						initial      := 0.0;
						'expression' := data 'k' / 100.0;
					}
				];
			}

			writes [data 'k', data 'x:0'];
		}
	]

	/**
	 * Keeps the points outside the gap (0.69, 0.81) around the global minimum at 0.757.
	 */
	pipeline 'training-region' [
		step {
			component 'condition-filter' {
				// the gap holds 11 grid points
				'maximum-consecutive-rejections' := 20;
				'condition' := data 'x:0' < 0.695 OR data 'x:0' > 0.805;
			}

			reads [data 'x:0'];
		}
	]

	/**
	 * Keeps the points in the gap: x:0 = 0.70, 0.71, ..., 0.80.
	 */
	pipeline 'gap' [
		step {
			component 'condition-filter' {
				// the 70 grid points before the gap are dropped one after the other
				'maximum-consecutive-rejections' := 100;
				'condition' := data 'x:0' > 0.695 AND data 'x:0' < 0.805;
			}

			reads [data 'x:0'];
		}
	]

	/**
	 * The Forrester function on the kept points.
	 */
	pipeline 'function' [
		step {
			component forrester {}

			reads [data 'x:0'];
			writes [data 'y:0'];
		}
	]

	// The training data leaves out the gap, the test data lies in it, so testing shows how
	// the surrogate extrapolates. The counts are the rows that pass the filter.
	begin
		write "output/training.csv" with 90 samples from executing ['grid', 'training-region', 'function'];
		write "output/test.csv" with 11 samples from executing ['grid', 'gap', 'function'];
	end
}
