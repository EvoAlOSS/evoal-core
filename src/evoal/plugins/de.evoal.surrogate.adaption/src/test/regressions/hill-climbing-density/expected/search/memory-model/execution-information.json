{
  "formatVersion" : "2027.4.0",
  "problem" : {
    "name" : "regression",
    "goals" : [ {
      "feature" : "y:0",
      "direction" : "maximise"
    } ],
    "function" : {
      "type" : "de.evoal.optimisation.core.unknown-function",
      "attributes" : { }
    }
  },
  "algorithm" : {
    "type" : "de.evoal.optimisation.local_search.optimisation.local-search",
    "attributes" : {
      "initialisation" : {
        "type" : "de.evoal.optimisation.core.specify-candidates",
        "attributes" : {
          "candidate-file" : null,
          "candidate-list" : [ {
            "type" : "de.evoal.optimisation.core.candidate",
            "attributes" : {
              "values" : [ {
                "type" : "de.evoal.optimisation.core.variable",
                "attributes" : {
                  "var" : "x:0",
                  "val" : 1.0
                }
              } ]
            }
          } ],
          "random" : false
        }
      },
      "optimisation-function" : {
        "type" : "de.evoal.surrogate.optimisation.surrogate",
        "attributes" : {
          "model-file" : "model.pson",
          "input-space" : [ "x:0" ],
          "output-space" : [ "y:0" ]
        }
      },
      "comparator" : {
        "type" : "de.evoal.optimisation.core.numeric-comparator",
        "attributes" : { }
      },
      "stopping-criteria" : [ {
        "type" : "de.evoal.optimisation.core.iteration-count",
        "attributes" : {
          "maximum-iterations" : 10
        }
      } ],
      "fitness-pipeline" : [ {
        "type" : "de.evoal.surrogate.adaption.density.optimisation.kernel-density",
        "attributes" : {
          "kind" : "both",
          "exponent" : 2.0,
          "root-exponent" : 1.0
        }
      } ],
      "candidate-checks" : [ ],
      "constraint-measure" : {
        "type" : "de.evoal.optimisation.core.exact-measure",
        "attributes" : {
          "equality-tolerance" : 1.0E-4
        }
      },
      "neighbour-choosing-strategy" : {
        "type" : "de.evoal.optimisation.local_search.optimisation.manual-strategy",
        "attributes" : {
          "step-size" : [ {
            "type" : "de.evoal.optimisation.core.variable",
            "attributes" : {
              "var" : "x:0",
              "val" : 0.2
            }
          } ],
          "neighbour-order" : "fixed"
        }
      },
      "accepting-strategy" : {
        "type" : "de.evoal.optimisation.local_search.optimisation.hill-climber",
        "attributes" : { }
      }
    }
  },
  "documentation" : [ {
    "type" : "de.evoal.optimisation.core.candidates-per-iteration",
    "attributes" : {
      "prefix-data" : false,
      "store-search-space" : true,
      "store-optimisation-space" : true
    }
  }, {
    "type" : "de.evoal.optimisation.core.memory-model",
    "attributes" : {
      "steps" : false
    }
  } ],
  "searchSpace" : [ {
    "name" : "x:0",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  } ],
  "optimisationSpace" : [ {
    "name" : "y:0",
    "type" : "real",
    "scale" : "quotient"
  } ],
  "fitness" : {
    "components" : [ {
      "name" : "y:0",
      "goal" : "y:0"
    } ],
    "steps" : [ {
      "type" : "de.evoal.surrogate.adaption.density.optimisation.kernel-density",
      "attributes" : {
        "kind" : "both",
        "exponent" : 2.0,
        "root-exponent" : 1.0
      }
    } ]
  },
  "metricDefinitions" : [ {
    "name" : "evaluations.real",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of evaluations of the real optimisation function."
  }, {
    "name" : "evaluations.surrogate",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of predictions of a surrogate model."
  } ],
  "setup" : {
    "evoalVersion" : "${evoal.version}",
    "seed" : "42",
    "run" : 0
  }
}
