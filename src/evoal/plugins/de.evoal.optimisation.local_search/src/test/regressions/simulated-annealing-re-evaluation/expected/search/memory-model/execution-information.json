{
  "formatVersion" : "2027.4.0",
  "problem" : {
    "name" : "regression",
    "goals" : [ {
      "feature" : "y:0",
      "direction" : "minimise"
    } ],
    "function" : {
      "type" : "de.evoal.pipeline.optimisation.benchmark-function",
      "attributes" : {
        "benchmarks" : [ {
          "type" : "de.evoal.pipeline.optimisation.benchmark-configuration",
          "attributes" : {
            "function" : {
              "type" : "de.evoal.pipeline.benchmarks.rosenbrock",
              "attributes" : { }
            },
            "reads" : [ "x:0", "x:1" ],
            "writes" : [ "y:0" ]
          }
        } ]
      }
    }
  },
  "algorithm" : {
    "type" : "de.evoal.optimisation.local_search.optimisation.local-search",
    "attributes" : {
      "initialisation" : {
        "type" : "de.evoal.optimisation.core.specify-candidates",
        "attributes" : {
          "candidate-list" : [ {
            "type" : "de.evoal.optimisation.core.candidate",
            "attributes" : {
              "values" : [ {
                "type" : "de.evoal.optimisation.core.variable",
                "attributes" : {
                  "var" : "x:0",
                  "val" : 1.1
                }
              }, {
                "type" : "de.evoal.optimisation.core.variable",
                "attributes" : {
                  "var" : "x:1",
                  "val" : 1.3
                }
              } ]
            }
          }, {
            "type" : "de.evoal.optimisation.core.candidate",
            "attributes" : {
              "values" : [ {
                "type" : "de.evoal.optimisation.core.variable",
                "attributes" : {
                  "var" : "x:0",
                  "val" : -3.0
                }
              }, {
                "type" : "de.evoal.optimisation.core.variable",
                "attributes" : {
                  "var" : "x:1",
                  "val" : 4.0
                }
              } ]
            }
          } ],
          "random" : false
        }
      },
      "optimisation-function" : {
        "type" : "de.evoal.optimisation.core.noisy-function",
        "attributes" : {
          "function" : {
            "type" : "de.evoal.optimisation.core.problem-function",
            "attributes" : { }
          },
          "noise" : "additive",
          "standard-deviation" : 0.5
        }
      },
      "comparator" : {
        "type" : "de.evoal.optimisation.core.numeric-comparator",
        "attributes" : { }
      },
      "stopping-criteria" : [ {
        "type" : "de.evoal.optimisation.core.iteration-count",
        "attributes" : {
          "maximum-iterations" : 10
        }
      } ],
      "fitness-pipeline" : [ ],
      "candidate-checks" : [ ],
      "constraint-measure" : {
        "type" : "de.evoal.optimisation.core.exact-measure",
        "attributes" : {
          "equality-tolerance" : 1.0E-4
        }
      },
      "evaluation-strategy" : {
        "type" : "de.evoal.optimisation.core.re-evaluation",
        "attributes" : {
          "samples" : 1,
          "aggregation" : "mean"
        }
      },
      "neighbour-choosing-strategy" : {
        "type" : "de.evoal.optimisation.local_search.optimisation.manual-strategy",
        "attributes" : {
          "step-size" : [ {
            "type" : "de.evoal.optimisation.core.variable",
            "attributes" : {
              "var" : "x:0",
              "val" : 0.1
            }
          }, {
            "type" : "de.evoal.optimisation.core.variable",
            "attributes" : {
              "var" : "x:1",
              "val" : 0.1
            }
          } ],
          "neighbour-order" : "fixed"
        }
      },
      "accepting-strategy" : {
        "type" : "de.evoal.optimisation.local_search.optimisation.simulated-annealing",
        "attributes" : {
          "initial-temperature" : 0.2,
          "decreasing-function" : {
            "type" : "de.evoal.optimisation.local_search.optimisation.geometric-decrease",
            "attributes" : {
              "decrease-rate" : 0.9
            }
          },
          "acceptance-probability" : {
            "type" : "de.evoal.optimisation.local_search.optimisation.exponential-probability",
            "attributes" : { }
          }
        }
      }
    }
  },
  "documentation" : [ {
    "type" : "de.evoal.optimisation.core.best-candidate-per-iteration",
    "attributes" : {
      "prefix-data" : false,
      "store-search-space" : true,
      "store-optimisation-space" : true
    }
  }, {
    "type" : "de.evoal.optimisation.core.memory-model",
    "attributes" : {
      "steps" : false
    }
  } ],
  "citations" : [ "berger2024evoal", "jin2005evolutionary", "kirkpatrick1983optimization", "rosenbrock1960automatic" ],
  "searchSpace" : [ {
    "name" : "x:0",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  }, {
    "name" : "x:1",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  } ],
  "optimisationSpace" : [ {
    "name" : "y:0",
    "type" : "real",
    "scale" : "quotient"
  } ],
  "fitness" : {
    "components" : [ {
      "name" : "y:0",
      "goal" : "y:0"
    } ],
    "steps" : [ ]
  },
  "metricDefinitions" : [ {
    "name" : "evaluations.real",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of evaluations of the real optimisation function."
  }, {
    "name" : "evaluations.surrogate",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of predictions of a surrogate model."
  } ],
  "propertyDefinitions" : [ {
    "name" : "samples",
    "scope" : "individual",
    "valueType" : "integer",
    "list" : false,
    "description" : "Number of evaluations whose objectives are aggregated in the output."
  }, {
    "name" : "objective-standard-deviations",
    "scope" : "individual",
    "valueType" : "real",
    "list" : true,
    "description" : "Sample standard deviation of every objective over the evaluations, in the order of the objectives; only with at least two evaluations."
  }, {
    "name" : "re-evaluated",
    "scope" : "relationship",
    "valueType" : "boolean",
    "list" : false,
    "description" : "The member was evaluated once more at the start of the iteration; its output aggregates all its evaluations."
  } ],
  "setup" : {
    "evoalVersion" : "${evoal.version}",
    "seed" : "42",
    "run" : 0
  }
}
