import "definitions" from 'de.evoal.core.constraints';
import "definitions" from 'de.evoal.core.base';

module de.evoal.optimisation.core {
    /**
     * The algorithm-independent problem description.
     */
    type problem {
    }

    /**
     * Abstract base type for functions mapping a solution from the search to
     *   the optimisation space.
     */
    abstract type 'optimisation-function' extends configuration {
    }

    /**
     * Place-holder for an unknown optimisation function.
     */
    type 'unknown-function' extends 'optimisation-function' {}

    /**
     * Abstract base type for the distance of a target goal ({@code optimise ... towards
     *   ... with ...}). A distance measures how far an objective value {@code v} is from
     *   the goal's target {@code t}. It is non-negative and 0 exactly at the target.
     */
    abstract type 'target-distance' extends configuration {}

    /**
     * Absolute distance: {@code abs(v - t)}.
     */
    type distance extends 'target-distance' {}

    /**
     * Squared distance: {@code (v - t)^2}. Penalises large deviations more than small
     *   ones.
     */
    type 'squared-distance' extends 'target-distance' {}

    /**
     * Relative distance: {@code abs(v - t) / max(abs(t), scale)}. For targets with
     *   {@code abs(t) >= scale}, the deviation is measured relative to the target. Below,
     *   including a target of 0, it is measured absolutely in units of {@code scale}.
     */
    type 'relative-distance' extends 'target-distance' {
        /**
         * The smallest denominator.
         */
        @LowerBoundary{ boundary := 0.0; inclusive := false; }
        scale : real := 1.0;
    }

    type 'search-space-distance' extends 'optimisation-function' {
        /**
         * The search space target to search for.
         */
        target : array instance variable;

        /**
         * Mapping of search space to optimisation space.
         */
        mapping : array instance mapping;
    }

    /**
     * Mapping of variables.
     */
    type mapping {
        /**
         * The input data.
         */
        input : data;

        /**
         * The output data.
         */
        output : data;
    }

    /**
     * A binding of a variable.
     */
    type variable {
        /**
         * The data to bind.
         */
        var : data;

        /**
         * The actual value.
         */
        val : literal;
    }


    /**
     * Abstract base type for optimisation algorithms.
     */
    abstract type algorithm extends configuration {
        /**
         * Source for initial candidates.
         */
        'initialisation' : instance 'initial-population';

        /**
         * Extension to the optimisation function defined in corresponding problem.
         */
        'optimisation-function' : instance 'fitness-function';

        /**
         * Comparator to use for comparing results of the optimisation function.
         */
        'comparator' : instance comparator;

        /**
         * Configurable stopping criterion.
         */
        @MinimumNumberOfElements{ bound := 1; }
        'stopping-criteria' : array instance 'stopping-criterion';

        /**
         * Further steps of the fitness pipeline. They run in their order after the
         *   direction steps, which are derived from the goals of the problem and convert
         *   the objectives into the canonical direction (minimisation).
         */
        'fitness-pipeline' : array instance 'fitness-step' := [];

        /**
         * Tests on candidates, each with a reaction to a failed test. A check type
         *   defines its check point: checks on new candidates run after the variation
         *   and before the evaluation, so a failed candidate costs no evaluation; they also
         *   test the initial candidates of algorithms with an initial population; checks
         *   on the population run at the end of every iteration. An algorithm that does
         *   not offer the check point of a configured check rejects the configuration.
         */
        'candidate-checks' : array instance 'candidate-check' := [];

        /**
         * Measures how far a candidate violates the constraints of the DDL
         *   ({@code constraint(expression, "group")} in the {@code constraints} section).
         *   Every evaluated candidate gets a violation record: the degree of violation of
         *   every constraint, which is 0 if the constraint is satisfied. Constraints on
         *   objectives use the result of the evaluation; the optimisation function is not
         *   called again. The record is stored in the memory model (properties
         *   {@code violation-<n>}, n is the position of the constraint in the DDL, from 1),
         *   and the measured constraints are counted in the metric
         *   {@code constraint-evaluations}. A group is handled by 'constraint-check',
         *   'constraint-penalty', 'feasibility-comparator', 'epsilon-comparator' or
         *   'nsga2-selection'; a group that nothing handles is reported as a warning.
         */
        'constraint-measure' : instance 'constraint-measure' := 'exact-measure' {};
    }

    /**
     * Abstract base type of the measures of constraint violations. A constraint is brought
     *   into the normal form g >= 0 (a < b becomes b - a, a > b becomes a - b, a = b becomes
     *   a - b as an equality). The degree of violation of an inequality is max(0, -g), the
     *   one of an equality max(0, |g| - 'equality-tolerance'). Strict and non-strict
     *   inequalities are measured alike. The degree is 0 exactly if the constraint is
     *   satisfied; the violation of a group is the sum of the degrees of its constraints.
     *   This is the usual definition, see T. Huang, Q. Zhang, W. Pedrycz, S. Yang: A
     *   quantitative pairwise comparison-based constraint handling technique for
     *   constrained optimization, arXiv:2310.13186, 2023, section 2.
     */
    abstract type 'constraint-measure' extends configuration {
        /**
         * The deviation up to which an equality counts as satisfied. The default 1e-4 is
         *   the tolerance of the CEC benchmarks of constrained optimisation (J. J. Liang
         *   et al.: Problem definitions and evaluation criteria for the CEC 2006 special
         *   session on constrained real-parameter optimization, technical report, 2006).
         */
        @LowerBoundary { boundary := 0.0; inclusive := true; }
        'equality-tolerance' : real := 1.0e-4;
    }

    /**
     * Measures the violation of a constraint at the values of the candidate.
     */
    type 'exact-measure' extends 'constraint-measure' {}

    /**
     * Accepts a measurement uncertainty: the degree of violation is the smallest degree
     *   when every feature f of the constraint is moved by -factor * sigma(f), 0 or
     *   +factor * sigma(f). The standard deviation sigma(f) is declared in the DDL by
     *   {@code 'standard-deviation'(data 'f', sigma)} in the {@code constraints} section;
     *   features without one are not moved. A constraint with k moved features is
     *   measured at 3^k points.
     */
    type 'tolerance-measure' extends 'constraint-measure' {
        /**
         * The multiple of the standard deviation by which a feature is moved.
         */
        @LowerBoundary { boundary := 0.0; inclusive := false; }
        factor : real;
    }

    /**
     * The reaction to a candidate that fails a check.
     *   'warn': the failure is reported; the candidate stays unchanged.
     *   'replace': a new candidate takes the place of the failed one. It comes from the
     *     'replacement-source' of the check, or from the 'initialisation' of the algorithm.
     *   'resample': the variation of the failed candidate is redone until the candidate
     *     passes the check, at most 'maximum-attempts' times; then the last candidate is
     *     kept and a warning is reported. An initial candidate has no variation; it is
     *     resampled by the next candidate of the 'initialisation'. Only for checks of new
     *     candidates in algorithms with a variation (the evolutionary algorithm).
     *   'repair': the candidate is repaired, at most 'maximum-attempts' times; then the
     *     fallback reaction of the check applies. Only checks that offer a repair
     *     strategy ('constraint-check').
     *
     * Every check type states the reactions it supports; a configuration with an
     *   unsupported reaction is rejected.
     */
    nominal enum 'check-reaction' ( warn, replace, resample, repair );

    /**
     * Abstract base type for tests on candidates (see {@code 'candidate-checks'} of
     *   {@code algorithm}). Every reaction is recorded in the memory model as a step of
     *   the kind {@code Check}. A replacement is linked to the candidate it replaces by a
     *   relationship of the kind {@code replacement} with the property {@code reason}.
     *   A replaced candidate that is not recorded (a new candidate, which is not evaluated,
     *   or a population member that is new in the iteration) has no individual, so its
     *   replacement has the property {@code reason} itself. A resampled candidate has
     *   the property {@code attempts}, the number of variations it took, on its
     *   relationship. A repaired candidate keeps the relationship of the failed
     *   candidate (e.g., to its parents) with the properties {@code repair}, the repair
     *   strategy, and {@code attempts}, the number of repair attempts. A candidate without
     *   relationship has these properties itself.
     */
    abstract type 'candidate-check' extends configuration {
        /**
         * The reaction to a failed candidate.
         */
        reaction : enum 'check-reaction';

        /**
         * The source of new candidates for the reaction 'replace'. If it is not set, the
         *   'initialisation' of the algorithm is used. A 'specify-candidates' source
         *   repeats its candidates, which is reported as a warning.
         */
        'replacement-source' : optional instance 'initial-population';

        /**
         * The maximum number of times the variation is redone for the reaction 'resample',
         *   or the repair is tried for the reaction 'repair'.
         */
        @LowerBoundary { boundary := 1; }
        'maximum-attempts' : int := 10;
    }

    /**
     * Fails a candidate of the population that is older than the given number of
     *   iterations. The age of a candidate is the number of iterations it was carried over
     *   into unchanged; a new candidate, e.g., a mutated one, has age 0. In a local search,
     *   the age counts the iterations without an accepted neighbour, so 'replace' gives a
     *   random restart after {@code iterations + 1} such iterations.
     *
     * Check point: the population. Reactions: 'warn', 'replace'.
     */
    type 'maximum-age' extends 'candidate-check' {
        /**
         * The highest age a candidate may have.
         */
        @LowerBoundary { boundary := 0; }
        iterations : int;
    }

    /**
     * Tests the constraints of a group on every new candidate (including the initial
     *   candidates), before its evaluation, so a failed candidate costs no evaluation. The constraints are measured with the
     *   'constraint-measure' of the algorithm; a candidate fails if the violation of the
     *   group is greater than 0. The degrees are kept for the candidate's violation record,
     *   so the evaluation does not measure these constraints again.
     *
     * The group must not contain constraints on objectives, since they can only be measured
     *   after the evaluation. 'repair' is required for the reaction 'repair' and not allowed
     *   for the other reactions.
     *
     * Check point: new candidates. Reactions: 'warn', 'replace', 'resample', 'repair'.
     */
    type 'constraint-check' extends 'candidate-check' {
        /**
         * The constraint group, as named in the DDL.
         */
        group : string;

        /**
         * The repair strategy for the reaction 'repair'. It must handle every constraint of
         *   the group.
         */
        repair : optional instance 'constraint-repair';

        /**
         * The reaction if the candidate still fails after 'maximum-attempts' repairs:
         *   'warn' keeps the unrepaired candidate, 'replace' and 'resample' react as for a
         *   failed candidate. 'repair' is not allowed.
         */
        'repair-fallback' : enum 'check-reaction' := 'check-reaction.warn';
    }

    /**
     * Abstract base type for the repair strategies of 'constraint-check'. A repair changes
     *   the values of the search features of a candidate. It is deterministic; every attempt
     *   starts from the result of the previous one. The values of integer features are
     *   rounded and all values are moved into the bounds of their features in the DDL.
     */
    abstract type 'constraint-repair' extends configuration {}

    /**
     * Saturation: a constraint on a single search feature x is a bound of x, and a violated
     *   bound sets x to the bound, in the order of the DDL. For an integer feature, x becomes
     *   the nearest integer on the feasible side, one step inside the bound if the
     *   comparison is strict. Only constraints that are linear in exactly one search
     *   feature, e.g. {@code 2 * x <= 3}. The name follows A. V. Kononova, D. Vermetten,
     *   F. Caraffini, M.-A. Mitran, D. Zaharie: The importance of being constrained: dealing
     *   with infeasible solutions in Differential Evolution and beyond. Evolutionary
     *   Computation, 2024, doi 10.1162/evco_a_00333, section 2.4.
     */
    type 'saturation-repair' extends 'constraint-repair' {}

    /**
     * Orthogonal projection: a violated constraint g(x) = a * x + c >= 0 (or = 0) moves the
     *   candidate onto its hyperplane, x + t * a with t = -g(x) / |a|^2. One attempt
     *   projects onto every violated constraint once, in the order of the DDL ("systematic
     *   projection", S. Agmon: The relaxation method for linear inequalities. Canadian
     *   Journal of Mathematics 6, 1954, pp. 382-392). Rounding and the bounds of the DDL may
     *   leave a constraint violated, so several attempts may be needed. Only constraints
     *   that are linear in the search features.
     */
    type 'projection-repair' extends 'constraint-repair' {}

    /**
     * Abstract base type for the steps of the fitness pipeline. A step computes a new
     *   fitness of a candidate from the fitness of the previous step.
     */
    abstract type 'fitness-step' extends configuration {}

    /**
     * Static penalty: adds weight times the violation of a constraint group (the sum of
     *   the degrees of its constraints, see 'constraint-measure') to every component of
     *   the canonical fitness. A feasible candidate keeps its fitness. The step changes
     *   the units of the fitness, so steps that need the units of the objectives must run
     *   before it.
     */
    type 'constraint-penalty' extends 'fitness-step' {
        /**
         * The constraint group, as named in the DDL.
         */
        group : string;

        /**
         * The factor of the violation.
         */
        @LowerBoundary { boundary := 0.0; inclusive := false; }
        weight : real;
    }

    /**
     * Divides fitness components by a reference value: {@code f / r}. Components that are
     *   not listed stay unchanged.
     */
    type scaling extends 'fitness-step' {
        /**
         * The reference value of each scaled objective ({@code var}: the objective,
         *   {@code val}: the reference value, greater than 0). Every objective is listed at
         *   most once.
         */
        @MinimumNumberOfElements{ bound := 1; }
        references : array instance variable;
    }

    /**
     * Keeps the fitness component of one objective and drops all others. The comparator
     *   then compares this component only.
     */
    type 'objective-selection' extends 'fitness-step' {
        /**
         * The objective whose fitness is kept.
         */
        objective : data;
    }

    /**
     * Abstract base type for steps that reduce the fitness to one component. A
     *   scalarisation must be the last step of {@code 'fitness-pipeline'}, and a pipeline
     *   has at most one.
     */
    abstract type scalarisation extends 'fitness-step' {}

    /**
     * Reduces the fitness to one component {@code weighted-sum}: the sum of the fitness
     *   components multiplied by their weights.
     */
    type 'weighted-sum' extends scalarisation {
        /**
         * The weight of each component ({@code var}: the objective, {@code val}: the
         *   weight). Either empty, then all components have the same weight, or every
         *   component is listed exactly once. Weights are not negative and at least one is
         *   greater than 0.
         */
        weights : array instance variable := [];

        /**
         * Whether the weights are divided by their sum, so that they sum to 1. This only
         *   changes the scale of the fitness, not the order of the candidates.
         */
        normalise : boolean := true;
    }

    /**
     * Comparator for comparing optimisation function results to each other.
     */
    abstract type comparator extends configuration {}

    /**
     * Compares the data in the specified order. First, the first data entry is compared.
     *   If the values differ, the comparison result is returned. If the values are equal,
     *   the next entry is taken into account.
     */
    type 'hierarchical-comparator' extends comparator {
        /**
         * Comparison order of the fitness data.
         */
        @MinimumNumberOfElements{ bound := 1; }
        order : array data;
    }

    /**
     * Comparator for a single number-based fitness value (such as a double).
     */
    type 'numeric-comparator' extends comparator {
    }

    /**
     * The feasibility rules (K. Deb: An efficient constraint handling method for genetic
     *   algorithms. Computer Methods in Applied Mechanics and Engineering 186(2-4), 2000,
     *   pp. 311-338) for a single fitness component: a feasible candidate is better than
     *   an infeasible one; two feasible candidates are compared by their fitness; two
     *   infeasible candidates by the violation of the group (the smaller is better).
     *   Feasible means that every constraint of the group is satisfied.
     */
    type 'feasibility-comparator' extends comparator {
        /**
         * The constraint group, as named in the DDL.
         */
        group : string;
    }

    /**
     * The epsilon-level comparison (T. Takahama, S. Sakai: Constrained optimization by the
     *   epsilon constrained differential evolution with gradient-based mutation and
     *   feasible elites. IEEE Congress on Evolutionary Computation 2006, pp. 1-8) for a
     *   single fitness component: like 'feasibility-comparator', but a candidate whose
     *   violation of the group is at most epsilon counts as feasible, and two candidates
     *   with the same violation are compared by their fitness. With epsilon 0, it equals
     *   the feasibility rules except for the last case.
     */
    type 'epsilon-comparator' extends comparator {
        /**
         * The constraint group, as named in the DDL.
         */
        group : string;

        /**
         * The violation of the group up to which a candidate counts as feasible.
         */
        @LowerBoundary { boundary := 0.0; inclusive := true; }
        epsilon : real;
    }

    /**
     * A fitness function during the optimisation (not at the problem-level).
     */
    abstract type 'fitness-function' extends 'optimisation-function' {}

    type 'random-fitness' extends 'fitness-function' {
    }

    type 'problem-function' extends 'fitness-function' {
    }

    /**
     * Abstract base type for initial population strategies.
     */
    abstract type 'initial-population' extends configuration {}

    /**
     * Chooses the initial population randomly from the search space. The selection
     *   process respects the boundaries defined at the data definition-level.
     */
    type 'random-population' extends 'initial-population' {
    }

    /**
    * specify an individual as a list of variables
    * specified variables should correspond to the total
    * specification (search and optimisation space)
    */
    type 'candidate' {
        @MinimumNumberOfElements{ bound := 1; }
        'values': array instance variable;
    }

    /**
    * reads candidate from file and uses this candidate
    * as the starting point.
    */
    type 'specify-candidates' extends 'initial-population' {
        'candidate-file' : optional string;

        'candidate-list': optional array instance candidate;

        //determines order of candidates read from file. Random (default) or linear.
        'random': boolean := true;
    }

    abstract type 'statistics-writer' extends configuration {
    }

    /**
     * Writes the best candidates (rank 0) of every iteration.
     *   File: <tt>best-candidate-per-iteration.csv</tt> in the output folder. Columns:
     *
     * <ul>
     *   <li>individual-id (id of the individual in the memory model; the same
     *     individual has the same id in all files)</li>
     *   <li>generation</li>
     *   <li>search-space-variable-1 ... search-space-variable-n</li>
     *   <li>optimisation-space-variable-1 ... optimisation-space-variable-n</li>
     * </ul>
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), the file
     *   starts with the columns <tt>repetition</tt> and, if target points are used,
     *   <tt>target</tt>. All runs append to the same file.
     */
    type 'best-candidate-per-iteration' extends 'statistics-writer' {
        /**
         * If set to <tt>true</tt>, every search space variable is prefixed with
         *   "<tt>search-space-value-</tt>" and every optimisation space variable
         *   is prefixed with "<tt>optimisation-space-value-</tt>". This can be
         *   useful if search and optimisation space share variables.
         */
        'prefix-data' : boolean := false;

        /**
         * If search space variables should be stored.
         */
        'store-search-space' : boolean := true;

        /**
         * If optimisation space variables should be stored.
         */
        'store-optimisation-space' : boolean := true;
    }

    /**
     * Writes the best candidate the algorithm has found up to and including every
     *   iteration (the memory model's <tt>bestSoFar</tt>). Unlike
     *   <tt>best-candidate-per-iteration</tt>, it does not get worse if the search
     *   moves to a worse candidate, e.g., in simulated annealing. The same
     *   individual appears in every row until a better one is found. Iterations of
     *   algorithms that do not track the best candidate are left out.
     *   File: <tt>best-candidate-so-far.csv</tt> in the output folder. Columns:
     *
     * <ul>
     *   <li>individual-id (id of the individual in the memory model; the same
     *     individual has the same id in all files)</li>
     *   <li>generation (the iteration, not the one in which the individual was found)</li>
     *   <li>search-space-variable-1 ... search-space-variable-n</li>
     *   <li>optimisation-space-variable-1 ... optimisation-space-variable-n</li>
     * </ul>
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), the file
     *   starts with the columns <tt>repetition</tt> and, if target points are used,
     *   <tt>target</tt>. All runs append to the same file.
     */
    type 'best-candidate-so-far' extends 'statistics-writer' {
        /**
         * If set to <tt>true</tt>, every search space variable is prefixed with
         *   "<tt>search-space-value-</tt>" and every optimisation space variable
         *   is prefixed with "<tt>optimisation-space-value-</tt>". This can be
         *   useful if search and optimisation space share variables.
         */
        'prefix-data' : boolean := false;

        /**
         * If search space variables should be stored.
         */
        'store-search-space' : boolean := true;

        /**
         * If optimisation space variables should be stored.
         */
        'store-optimisation-space' : boolean := true;
    }

    /**
     * Writes all surviving candidates of every iteration.
     *   File: <tt>candidates-per-iteration.csv</tt> in the output folder. Columns:
     *
     * <ul>
     *   <li>individual-id (id of the individual in the memory model; the same
     *     individual has the same id in all files)</li>
     *   <li>generation</li>
     *   <li>search-space-variable-1 ... search-space-variable-n</li>
     *   <li>optimisation-space-variable-1 ... optimisation-space-variable-n</li>
     * </ul>
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), the file
     *   starts with the columns <tt>repetition</tt> and, if target points are used,
     *   <tt>target</tt>. All runs append to the same file.
     */
    type 'candidates-per-iteration' extends 'statistics-writer' {
        /**
         * If set to <tt>true</tt>, every search space variable is prefixed with
         *   "<tt>search-space-value-</tt>" and every optimisation space variable
         *   is prefixed with "<tt>optimisation-space-value-</tt>". This can be
         *   useful if search and optimisation space share variables.
         */
        'prefix-data' : boolean := false;

        /**
         * If search space variables should be stored.
         */
        'store-search-space' : boolean := true;


        /**
         * If optimisation space variables should be stored.
         */
        'store-optimisation-space' : boolean := true;
    }

    /**
     * Writes the metrics of every iteration, e.g., the number of evaluations.
     *   File: <tt>metrics-per-iteration.csv</tt> in the output folder.
     *   Columns: iteration, then one column per metric of the run, named after the
     *   metric (e.g., evaluations.real, evaluations.surrogate).
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), the file
     *   starts with the columns <tt>repetition</tt> and, if target points are used,
     *   <tt>target</tt>. All runs append to the same file.
     */
    type 'metrics-per-iteration' extends 'statistics-writer' {}

    /**
     * Writes the constraint violations of every iteration.
     *   File: <tt>constraint-statistics.csv</tt> in the output folder.
     *   Columns: iteration, then for every constraint group of the DDL, in the order of
     *   the DDL, <tt>infeasible-&lt;group&gt;</tt>, the number of individuals that survive
     *   the iteration (the population) and violate the group, and
     *   <tt>violation-&lt;group&gt;</tt>, the sum of their violations of the group (see
     *   'constraint-measure').
     *
     * A problem without constraints is rejected.
     */
    type 'constraint-statistics' extends 'statistics-writer' {}

    /**
     * Compares the correlations of the DDL ('correlation', 'ranged-correlation') with the
     *   population of every iteration.
     *   File: <tt>correlation-statistics.csv</tt> in the output folder.
     *   Columns: iteration, then for every correlation n of the DDL (members of the
     *   population inside its ranges):
     *   with 'empirical-correlation': <tt>n-&lt;n&gt;</tt> (their number),
     *   <tt>correlation-&lt;n&gt;</tt> (the Pearson correlation, the Spearman rank
     *   correlation if a feature is ordinal) and <tt>deviation-&lt;n&gt;</tt> (empirical
     *   minus declared coefficient);
     *   with 'covariance-difference': <tt>covariance-difference-&lt;n&gt;</tt> (the
     *   covariance in the population minus the one in the initial population).
     *   A value that cannot be computed is empty. Correlations with a nominal feature have
     *   no columns.
     *
     * Sources: K. Pearson: Mathematical contributions to the theory of evolution. III.
     *   Regression, heredity, and panmixia. Philosophical Transactions A 187, 1896,
     *   pp. 253-318; C. Spearman: The proof and measurement of association between two
     *   things. American Journal of Psychology 15(1), 1904, pp. 72-101.
     *
     * A problem without correlations or a configuration without output is rejected.
     */
    type 'correlation-statistics' extends 'statistics-writer' {
        /**
         * Whether the number of members, the empirical correlation and its deviation from
         *   the declared coefficient are written.
         */
        'empirical-correlation' : boolean := true;

        /**
         * Whether the difference of the covariance to the initial population is written.
         */
        'covariance-difference' : boolean := false;
    }

    /**
     * Writes the memory model of every run as JSON files into the folder
     *   <tt>memory-model</tt> in the output folder, while the run is executed:
     *
     * <ul>
     *   <li><tt>execution-information.json</tt> before the first iteration: problem,
     *     goals, algorithm, search and optimisation space, metric definitions, property
     *     definitions (if any), and what is needed to repeat the run (EvoAl version, seed,
     *     run).</li>
     *   <li><tt>iteration-&lt;n&gt;.json</tt> for every iteration: its individuals with
     *     their values, origin (relationships) and properties (e.g. the reason of a
     *     replacement), its steps, ranks and metrics.</li>
     *   <li><tt>execution-finished.json</tt> after the last iteration: the number of
     *     iterations, the best individuals and the execution metrics. Signals that no
     *     further files follow.</li>
     * </ul>
     *
     * Every file is first written into the subfolder <tt>.incomplete</tt> and then moved
     *   into place, so readers never see a partially written file. The folder of a run is
     *   deleted when the run starts. The format is described by JSON schemas
     *   (<tt>https://www.evoal.de/schemas/memory-model/2027.4.0/</tt>).
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), every run gets its own
     *   folder <tt>memory-model/repetition-&lt;repetition&gt;</tt>, or
     *   <tt>memory-model/target-&lt;target&gt;/repetition-&lt;repetition&gt;</tt> if target
     *   points are used.
     */
    type 'memory-model' extends 'statistics-writer' {
        /**
         * Whether the executed steps of every iteration (e.g. "Initialization: sample 10
         *   candidates") are written into <tt>iteration-&lt;n&gt;.json</tt>. All algorithms
         *   record their steps.
         */
        'steps' : boolean := false;
    }

    /**
     * Does not write any statistics. Can be used to disable statistics output.
     */
    type none extends 'statistics-writer' {}

    /**
     * Base class for all stopping criteria of optimisation algorithms.
     */
    abstract type 'stopping-criterion' extends configuration {
    }

    /**
     * Stopping criterion that stops after a fixed number of iterations.
     */
    type 'iteration-count' extends 'stopping-criterion' {
        /**
         * Maximum number of iterations. The initial evaluation is iteration 0,
         * so a run with value n records the iterations 0 to n.
         */
        @LowerBoundary { boundary := 0; }
        'maximum-iterations' : int := 10;
    }

    /**
     * What happens if an evaluation budget runs out in the middle of an iteration.
     *   'finish-iteration': the iteration is finished, so a run can use more
     *     evaluations than the budget. The run stops after the iteration.
     *   'cut-off': a run never uses more evaluations than the budget. The run stops
     *     immediately and records the partial iteration.
     */
    nominal enum 'budget-exhaustion' ( 'finish-iteration', 'cut-off' );

    /**
     * Stopping criterion that stops when the number of evaluations of the real
     *   optimisation function reaches a budget. Evaluations of a surrogate model are
     *   counted separately and do not use the budget. The number of evaluations is
     *   the metric 'evaluations.real' of every iteration.
     */
    type 'evaluation-budget' extends 'stopping-criterion' {
        /**
         * Maximum number of evaluations of the real optimisation function.
         */
        @LowerBoundary { boundary := 1; }
        'maximum-evaluations' : int;

        /**
         * What happens if the budget runs out in the middle of an iteration.
         */
        'exhaustion' : enum 'budget-exhaustion' := 'budget-exhaustion.finish-iteration';
    }

    /**
     * Stopping criterion that stops when a file is created.
     */
    type 'file-check' extends 'stopping-criterion' {
        /**
         * Name of file.
         */
        'file' : string := "evoal-stop.txt";
    }

    /**
     * Writes for every iteration which of the given stopping criteria are satisfied.
     *   File: <tt>stopping-per-candidates-per-generation.csv</tt> in the output folder.
     *   Columns: generation, criterion-0 ... criterion-n
     *   ({@code 1} if the criterion is satisfied, {@code 0} otherwise).
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), the file
     *   starts with the columns <tt>repetition</tt> and, if target points are used,
     *   <tt>target</tt>. All runs append to the same file.
     */
    type 'stopping-per-candidates-per-generation' extends 'statistics-writer' {
        criteria : array instance 'stopping-criterion' := [];
    }

    /**
     * Writes for every individual of every iteration which of the given
     *   candidate-based stopping criteria are satisfied.
     *   File: <tt>stopping-per-candidates-per-iteration.csv</tt> in the output folder.
     *   Columns: generation, individual-id (id of the individual in the memory
     *   model), criterion-0 ... criterion-n
     *   ({@code 1} if the criterion is satisfied, {@code 0} otherwise).
     *
     * In the evaluation setup ({@code heuristic-search-evaluation}), the file
     *   starts with the columns <tt>repetition</tt> and, if target points are used,
     *   <tt>target</tt>. All runs append to the same file.
     */
    type 'stopping-per-candidates-per-iteration' extends 'statistics-writer' {
        criteria : array instance 'stopping-criterion' := [];
    }
}
