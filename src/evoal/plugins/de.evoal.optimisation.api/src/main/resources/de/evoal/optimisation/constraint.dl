import "definitions" from 'de.evoal.core.constraints';

module de.evoal.optimisation.constraint {
    /**
     * Declares the standard deviation of the measurements of a feature. The
     *   'tolerance-measure' moves the feature by a multiple of it when it measures a
     *   constraint violation.
     *
     * <b>Parameters:</b>
     * <ol>
     *   <li>The feature.</li>
     *   <li>Its standard deviation, not negative.</li>
     * </ol>
     */
    def void 'standard-deviation'(data reference, real deviation);

    /**
     * Declares the correlation of two search features. Correlation-aware operators of the
     *   evolutionary algorithm ('correlation-aware-mutation', 'linkage-crossover') use it,
     *   and 'correlation-statistics' compares it with the population. The coefficient is
     *   the Pearson correlation (Pearson 1896) for cardinal and quotient features and the
     *   Spearman rank correlation (Spearman 1904) if a feature is ordinal; a correlation
     *   with a nominal feature is skipped.
     *
     * <b>Parameters:</b>
     * <ol>
     *   <li>The first feature.</li>
     *   <li>The second feature, not the first one.</li>
     *   <li>The correlation coefficient, in [-1, 1].</li>
     * </ol>
     */
    @Literature { keys := ["pearson1896mathematical", "spearman1904proof"]; }
    def void correlation(data feature1, data feature2, real coefficient);

    /**
     * Declares the correlation of two search features that applies only while both lie in
     *   their ranges, see 'correlation'.
     *
     * <b>Parameters:</b>
     * <ol>
     *   <li>The first feature.</li>
     *   <li>Its range, {@code range(lower, upper)}, both bounds included.</li>
     *   <li>The second feature, not the first one.</li>
     *   <li>Its range, {@code range(lower, upper)}.</li>
     *   <li>The correlation coefficient, in [-1, 1].</li>
     * </ol>
     */
    @Literature { keys := ["pearson1896mathematical", "spearman1904proof"]; }
    def void 'ranged-correlation'(data feature1, expression range1, data feature2, expression range2, real coefficient);

    /**
     * Declares a building block, a group of search features that interact, i.e. the
     *   problem is not separable in them, e.g.
     *   {@code 'building-block'([data 'x:0', data 'x:7', data 'x:12']);}. The
     *   'linkage-crossover' of the evolutionary algorithm keeps the features of a building
     *   block together; the 'correlation-aware-mutation' ignores building blocks, since they
     *   have no coefficient. A feature may belong to several building blocks. The term
     *   follows Harik and Goldberg 1997, section 2: the linkage of a building block is the
     *   probability that crossover preserves it.
     *
     * <b>Parameters:</b>
     * <ol>
     *   <li>The features of the building block, at least two and none twice.</li>
     * </ol>
     */
    @Literature { keys := ["harik1997learning"]; }
    def void 'building-block'(array data features);

    /**
     * Declares a constraint of the optimisation problem, a comparison of two arithmetic
     *   expressions over search features, objectives and numbers with one of the
     *   operators {@code <}, {@code <=}, {@code >}, {@code >=} or {@code =}.
     *
     * <b>Parameters:</b>
     * <ol>
     *   <li>The comparison.</li>
     *   <li>The group of the constraint. A group is handled as a whole, e.g., by
     *     'constraint-penalty' or 'feasibility-comparator'.</li>
     * </ol>
     */
    def void constraint(expression exp, string category);

    /**
     * A range of values for 'ranged-correlation', both bounds included.
     *
     * <b>Parameters:</b>
     * <ol>
     *   <li>The lower bound.</li>
     *   <li>The upper bound, not smaller than the lower bound.</li>
     * </ol>
     */
    def void range(real lower, real upper);
}
