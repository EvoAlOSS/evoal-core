{
  "formatVersion" : "2027.4.0",
  "problem" : {
    "name" : "regression",
    "goals" : [ {
      "feature" : "y:0",
      "direction" : "minimise"
    } ],
    "function" : {
      "type" : "de.evoal.pipeline.optimisation.benchmark-function",
      "attributes" : {
        "benchmarks" : [ {
          "type" : "de.evoal.pipeline.optimisation.benchmark-configuration",
          "attributes" : {
            "function" : {
              "type" : "de.evoal.pipeline.benchmarks.rastrigin",
              "attributes" : {
                "a" : 10.0
              }
            },
            "reads" : [ "x:0", "x:1" ],
            "writes" : [ "y:0" ]
          }
        } ]
      }
    }
  },
  "algorithm" : {
    "type" : "de.evoal.optimisation.random_search.optimisation.random-search",
    "attributes" : {
      "initialisation" : {
        "type" : "de.evoal.optimisation.core.random-population",
        "attributes" : {
          "method" : null
        }
      },
      "optimisation-function" : {
        "type" : "de.evoal.optimisation.core.noisy-function",
        "attributes" : {
          "function" : {
            "type" : "de.evoal.optimisation.core.problem-function",
            "attributes" : { }
          },
          "noise" : "multiplicative",
          "standard-deviation" : 0.2
        }
      },
      "comparator" : {
        "type" : "de.evoal.optimisation.core.numeric-comparator",
        "attributes" : { }
      },
      "stopping-criteria" : [ {
        "type" : "de.evoal.optimisation.core.iteration-count",
        "attributes" : {
          "maximum-iterations" : 10
        }
      }, {
        "type" : "de.evoal.optimisation.core.evaluation-budget",
        "attributes" : {
          "maximum-evaluations" : 100,
          "exhaustion" : "cut-off"
        }
      } ],
      "fitness-pipeline" : [ ],
      "candidate-checks" : [ ],
      "constraint-measure" : {
        "type" : "de.evoal.optimisation.core.exact-measure",
        "attributes" : {
          "equality-tolerance" : 1.0E-4
        }
      },
      "evaluation-strategy" : {
        "type" : "de.evoal.optimisation.core.resampling",
        "attributes" : {
          "samples" : 3,
          "aggregation" : "median"
        }
      },
      "samples-per-iteration" : 10
    }
  },
  "documentation" : [ {
    "type" : "de.evoal.optimisation.core.best-candidate-per-iteration",
    "attributes" : {
      "prefix-data" : false,
      "store-search-space" : true,
      "store-optimisation-space" : true
    }
  }, {
    "type" : "de.evoal.optimisation.core.memory-model",
    "attributes" : {
      "steps" : false
    }
  } ],
  "citations" : [ "berger2024evoal", "jin2005evolutionary", "rastrigin1974systems" ],
  "searchSpace" : [ {
    "name" : "x:0",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  }, {
    "name" : "x:1",
    "type" : "real",
    "scale" : "quotient",
    "lowerBound" : {
      "value" : -5.12,
      "inclusive" : true
    },
    "upperBound" : {
      "value" : 5.12,
      "inclusive" : true
    }
  } ],
  "optimisationSpace" : [ {
    "name" : "y:0",
    "type" : "real",
    "scale" : "quotient"
  } ],
  "fitness" : {
    "components" : [ {
      "name" : "y:0",
      "goal" : "y:0"
    } ],
    "steps" : [ ]
  },
  "metricDefinitions" : [ {
    "name" : "evaluations.real",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of evaluations of the real optimisation function."
  }, {
    "name" : "evaluations.surrogate",
    "kind" : "counter",
    "valueType" : "integer",
    "scope" : "iteration",
    "description" : "Number of predictions of a surrogate model."
  }, {
    "name" : "evaluations.real.budget",
    "kind" : "measure",
    "valueType" : "integer",
    "scope" : "execution",
    "description" : "Maximum number of evaluations ('evaluations.real')."
  } ],
  "propertyDefinitions" : [ {
    "name" : "samples",
    "scope" : "individual",
    "valueType" : "integer",
    "list" : false,
    "description" : "Number of evaluations whose objectives are aggregated in the output."
  }, {
    "name" : "objective-standard-deviations",
    "scope" : "individual",
    "valueType" : "real",
    "list" : true,
    "description" : "Sample standard deviation of every objective over the evaluations, in the order of the objectives; only with at least two evaluations."
  } ],
  "setup" : {
    "evoalVersion" : "${evoal.version}",
    "seed" : "42",
    "run" : 0
  }
}
