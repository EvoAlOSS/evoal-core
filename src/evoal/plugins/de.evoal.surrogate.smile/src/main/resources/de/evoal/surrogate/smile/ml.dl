import "definitions" from 'de.evoal.core.constraints';
import "definitions" from 'de.evoal.surrogate.ml';

/**
 * Module containing support vector regression-based surrogat models.
 */
module de.evoal.surrogate.smile.ml {
	/**
	 * Base type for all supported Mercer kernels (used by SVR and Gaussian
	 *   Processes).
	 */
	abstract type kernel {
	}
	
	/**
	 * A linear kernel
	 */
	type linear extends kernel {
	}

	/**
	 * The polynomial kernel: 
	 * 
	 * <math class="tml-display" style="display:block math;">
	 *   <mrow>
	 *     <mi>k</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>u</mi>
	 *     <mo separator="true">,</mo>
	 *     <mi>v</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *     <mo>=</mo>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>γ</mi>
 	 *     <msup>
	 *       <mi>u</mi>
	 *       <mi class="tml-sml-pad">T</mi>
	 *     </msup>
	 *     <mi>v</mi>
	 *     <mo>+</mo>
	 *     <mi>λ</mi>
	 *     <msup>
	 *       <mo form="postfix" stretchy="false">)</mo>
	 *       <mi>d</mi>
	 *     </msup>
	 *   </mrow>
	 * </math> <br/>
     * where γ is the scale of the used inner product, λ the offset of the used
     *   inner product, and d the order of the polynomial kernel.
	 */
	type polynomial extends kernel {
		/**
		 * Order of the polynomial.
		 */
		@LowerBoundary{ boundary := 1; }
		'degree'        : int;
		
		/**
		 * Scale of the inner product.
		 */
		'scale'         : real;
		
		/**
		 * Offset of the inner product.
		 */
		@LowerBoundary{ boundary := 0.0; }
		'offset'        : real;
	}
	
	/**
	 * Gaussian kernel, also referred as RBF kernel or squared exponential kernel:
	 * <math class="tml-display" style="display:block math;">
	 *   <mrow>
	 *     <mi>k</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>u</mi>
	 *     <mo separator="true">,</mo>
	 *     <mi>v</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *     <mo>=</mo>
	 *     <mi>e</mi>
	 *     <mi>x</mi>
	 *     <mi>p</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mo form="prefix" stretchy="false">−</mo>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>u</mi>
	 *     <mo>−</mo>
	 *     <mi>v</mi>
	 *     <mi>|</mi>
	 *     <msup>
	 *       <mi>|</mi>
	 *       <mn>2</mn>
	 *     </msup>
	 *     <mi>/</mi>
	 *     <mn>2</mn>
	 *     <msup>
	 *       <mi>σ</mi>
	 *       <mn>2</mn>
	 *     </msup>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *   </mrow>
	 * </math><br/>
	 * 
	 * where σ > 0 is the scale parameter of the kernel.<br/>
	 * The Gaussian kernel is a good choice for a great deal of applications, although
	 *   sometimes it is remarked as being overused.
	 */
	type  'gaussian' extends kernel {
		/**
		 * The length scale of kernel.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'σ'             : real;
	}
	
	/**
	 * The class of Matérn kernels is a generalization of the Gaussian/RBF. It
	 *   has an additional parameter ν, which controls the smoothness of the
	 *   kernel function. The smaller ν, the less smooth the approximated function
	 *   is. As ν -> inf, the kernel becomes equivalent to the Gaussian/RBF kernel.
	 *   When ν = 1/2, the kernel becomes identical to the Laplacian kernel. The
	 *   Matérn kernel become especially simple when ν is half-integer. Important
     *   intermediate values are 3/2 (once differentiable functions) and 5/2 (twice
     *   differentiable functions).
	 */
	@MultiVariateConstraint { 'expression' := self.'ν' = 0.5 OR self.'ν' = 1.5 OR self.'ν' = 2.5; }
	type 'matérn' extends kernel {
		/**
		 * The length scale of the kernel.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'σ'				: real;

		/**
		 * The smoothness of the kernel function: 0.5, 1.5 or 2.5. For an infinite ν use the
		 *   'gaussian' kernel.
		 */
	    'ν'				: real;
	}
	
	/**
	 * Laplacian kernel, also referred as exponential kernel:
	 * <math class="tml-display" style="display:block math;">
	 *   <mrow>
	 *     <mi>k</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>u</mi>
	 *     <mo separator="true">,</mo>
	 *     <mi>v</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *     <mo>=</mo>
	 *     <mi>e</mi>
	 *     <mi>x</mi>
	 *     <mi>p</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mo form="prefix" stretchy="false">−</mo>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>u</mi>
	 *     <mo>−</mo>
	 *     <mi>v</mi>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>/</mi>
	 *     <mi>σ</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *   </mrow>
	 * </math><br/>
	 * where σ > 0 is the scale parameter of the kernel.
	 */
	type laplacian extends kernel {
		/**
		 * The length scale of kernel.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'σ'             : real;		
	}
	
	/**
	 * The hyperbolic tangent kernel:
	 * <math class="tml-display" style="display:block math;">
	 *   <mrow>
	 *     <mi>k</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>u</mi>
	 *     <mo separator="true">,</mo>
	 *     <mi>v</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *     <mo>=</mo>
	 *     <mi>t</mi>
	 *     <mi>a</mi>
	 *     <mi>n</mi>
 	 *    <mi>h</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>γ</mi>
	 *     <msup>
	 *       <mi>u</mi>
	 *       <mi class="tml-sml-pad">T</mi>
	 *     </msup>
	 *     <mi>v</mi>
	 *     <mo>+</mo>
	 *     <mi>λ</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *   </mrow>
	 * </math><br/>
	 * 
	 * where γ is the scale of the used inner product and λ is the offset of the
	 * used inner product. If the offset is negative the likelihood of obtaining
	 * a kernel matrix that is not positive definite is much higher (since then
	 * even some diagonal elements may be negative), hence if this kernel has to
	 * be used, the offset should always be positive; a negative offset gives a
	 * warning. Note, however, that this is no guarantee that the kernel will be
	 * positive.<br/>
	 * The hyperbolic tangent kernel was quite popular for support vector machines
	 * due to its origin from neural networks. However, it should be used carefully
	 * since the kernel matrix may not be positive semi-definite. Besides, it was
	 * reported the hyperbolic tangent kernel is not better than the Gaussian kernel
	 * in general.
	 */
	type 'hyperbolic-tangent' extends kernel {
		/**
		 * The scale parameter.
		 */
		scale           : real;
		
		/**
		 * The offset parameter.
		 */
		@LowerBoundary{ boundary := 0.0; severity := Severity.warning; }
		offset          : real;		
	}
	
	/**
	 * Pearson VII universal kernel. The Pearson VII function is often used for curve
     *   fitting of X-ray diffraction scans and single bands in infrared spectra.<br/>
     * <br/>
	 * Reference: Üstün, Melssen and Buydens 2006.
	 */
	@Literature { keys := ["uestuen2006facilitating"]; }
	type 'pearson' extends 'kernel' {
		
		/**
		 * Pearson width.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'σ'             : real;

		/**
		 * The tailing factor of the peak.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'ω'             : real;
	}
	
	
	/**
	 * The Thin Plate Spline kernel:
	 * <math class="tml-display" style="display:block math;">
	 *   <mrow>
	 *     <mi>k</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>u</mi>
	 *     <mo separator="true">,</mo>
	 *     <mi>v</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *     <mo>=</mo>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>u</mi>
	 *     <mo>−</mo>
	 *     <mi>v</mi>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>/</mi>
	 *     <mi>σ</mi>
	 *     <msup>
	 *       <mo form="postfix" stretchy="false">)</mo>
	 *       <mn>2</mn>
	 *     </msup>
	 *     <mi>l</mi>
	 *     <mi>o</mi>
	 *     <mi>g</mi>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>u</mi>
	 *     <mo>−</mo>
	 *     <mi>v</mi>
	 *     <mi>|</mi>
	 *     <mi>|</mi>
	 *     <mi>/</mi>
	 *     <mi>σ</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *   </mrow>
	 * </math>
	 * <br/>
	 * where σ > 0 is the scale parameter of the kernel.
	 */
	type 'thin-plate-spline' extends kernel {
		/**
		 * The length scale of kernel.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'σ'             : real;				
	}

	/**
	 * The Hellinger kernel.<br/>
	 * The Hellinger distance is used to quantify the similarity between two
	 *   probability distributions. It is a type of f-divergence. The Hellinger
	 *   distance 
     * <math class="tml-display" style="display:block math;">
     *   <mrow>
     *     <mi>H</mi>
     *     <mo form="prefix" stretchy="false">(</mo>
     *     <mi>P</mi>
     *     <mo separator="true">,</mo>
     *     <mi>Q</mi>
     *     <mo form="postfix" stretchy="false">)</mo>
     *   </mrow>
     * </math>
	 *   on discrete distributions is equivalent to the Euclidean distance of the
	 *   square root vectors. The Hellinger kernel is
	 * <math class="tml-display" style="display:block math;">
	 *   <mrow>
	 *     <mn>1</mn>
	 *     <mo>−</mo>
	 *     <mi>H</mi>
	 *     <mn>2</mn>
	 *     <mo form="prefix" stretchy="false">(</mo>
	 *     <mi>P</mi>
	 *     <mo separator="true">,</mo>
	 *     <mi>Q</mi>
	 *     <mo form="postfix" stretchy="false">)</mo>
	 *   </mrow>
	 * </math>
	 * , which is equivalent to the dot product of the square root vectors.
	 */	
	type hellinger extends kernel {
	}
	
	/**
	 * The sum kernel takes two kernels and combines them via k1(x, y) + k2(x, y)
	 */
	type sum extends kernel {
		/**
		 * The first kernel to combine
		 */
		'kernel-1' : instance kernel;

		/**
		 * The second kernel to combine
		 */
		'kernel-2' : instance kernel;
	}

	/**
	 * The product kernel takes two kernels and combines them via k1(x, y) * k2(x, y)
	 */
	type product extends kernel {
		/**
		 * The first kernel to combine
		 */
		'kernel-1' : instance kernel;

		/**
		 * The second kernel to combine
		 */
		'kernel-2' : instance kernel;
	}

	/**
	 * Epsilon support vector regression. Like SVMs for classification, the model
	 *   produced by SVR depends only on a subset of the training data, because
     *   the cost function ignores any training data close to the model prediction
     *   (within a threshold ε).<br/>
     * <br/>
	 * References: Smola and Schoelkopf 2004; Flake and Lawrence 2002; Burges 1998;
	 *   Platt 1998; Fan, Chen and Lin 2005; Bordes et al. 2005; Glasmachers and Igel
	 *   2008; Chang and Lin 2011 (LIBSVM).
	 */
	@Literature { keys := ["smola2004tutorial", "flake2002efficient", "burges1998tutorial", "platt1998sequential",
	                       "fan2005working", "bordes2005fast", "glasmachers2008second", "chang2011libsvm"]; }
	@RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "/task/inputs"; }
	type 'epsilon-svr' extends surrogate {
		/**
	     * The soft margin penalty parameter C: the weight of the training errors outside the
	     *   ε-tube against the flatness of the model. A larger C fits the training data more
	     *   closely.
	     */
		@LowerBoundary{ boundary := 0.0; inclusive := true; }
		'soft-margin'   : real;

		/**
		 * The tolerance of the convergence test of the solver; training stops when the
		 *   optimality conditions hold up to this tolerance (e.g. 0.001).
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		tolerance       : real;

		/**
		 * The width of the ε-tube: errors up to ε are not penalised. The learner standardises
		 *   the output (mean 0, standard deviation 1) before training, so ε is given in standard
		 *   deviations of the training output. An ε of at least half the range of the
		 *   standardised output gives a constant model; the learner warns about it.
		 */
		@LowerBoundary{ boundary := 0.0; inclusive := false; }
		'ε'             : real;

		/**
		 * The kernel function that is used.
		 */
		kernel			: instance kernel;
	}

    /**
     * Gaussian process regression (kriging): the kernel is the covariance of the modelled
     *   function, and the prediction at a point is the mean of the function given the training
     *   data. It models a single output. With 'iterations' > 0 the hyperparameters of the
     *   kernel (e.g. the length scale σ of a Gaussian kernel) and the noise are fitted by
     *   maximising the log marginal likelihood of the training data; the configured values are
     *   the starting point. The model file stores the fitted values.<br/>
     * <br/>
     * Reference: Rasmussen and Williams 2006.
     */
    @Literature { keys := ["rasmussen2006gaussian"]; }
    @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "/task/inputs"; }
    type 'gaussian-process' extends surrogate {

        /**
         * The covariance function of the modelled function.
         */
        'kernel' : instance kernel;

        /**
         * The noise variance added to the diagonal of the kernel matrix. With 'normalize' it
         *   refers to the normalised output (variance 1). A small value (e.g. 1e-6) makes the
         *   model interpolate the training data, a larger one smooths it. With
         *   'iterations' > 0 it is the starting value of the fit, which stays in [1e-10, 1e5].
         */
        @LowerBoundary{ boundary := 0.0; inclusive := false; }
        'noise' : real;

        /**
         * Whether the output is centred and scaled to variance 1 before fitting; the
         *   predictions are scaled back.
         */
        'normalize' : boolean;

        /**
         * The convergence tolerance of the fit of the hyperparameters (BFGS); used only with
         *   'iterations' > 0.
         */
        @LowerBoundary{ boundary := 0.0; inclusive := false; }
        'tolerance' : real;

        /**
         * The maximum number of iterations of the fit of the kernel hyperparameters and the
         *   noise (BFGS). 0 keeps the configured kernel and noise. During the fit a length scale
         *   stays in [1e-5, 1e5]; the smoothness ν of a Matérn kernel is not fitted.
         */
        @LowerBoundary{ boundary := 0; }
        'iterations' : int;
    }

    /**
     * The point prediction of a 'gradient-boosting' model.
     */
    nominal enum 'point-prediction' ( mean, median );

    /**
     * Which rows the trees of the three models of a 'gradient-boosting' model are fitted on.
     */
    nominal enum 'row-sampling' ( shared, independent );

    /**
     * Gradient boosting with regression trees and a prediction interval: three models of
     *   'number-trees' trees each are fitted to the training data. The first one predicts the
     *   output ('point-prediction'), the other two predict the lower and the upper quantile of
     *   the output, (1 − 'coverage') / 2 and (1 + 'coverage') / 2 (quantile regression). The
     *   bounds form a prediction interval that holds a new observation with the probability
     *   'coverage'; its width follows the noise of the data, e.g. wide where the output
     *   scatters. The three values are sorted at every point, so the bounds do not cross. The
     *   model has a single output; its model file is an ONNX file ('.onnx') with the outputs
     *   y, y.lower and y.upper for the output y.<br/>
     * <br/>
     * Each model starts with a constant and adds one tree at a time; a tree is fitted to the
     *   negative gradient of the loss of the model so far, on a random sample of the training
     *   rows, and is added with the weight 'shrinkage'.<br/>
     * <br/>
     * References: Friedman 2001; Friedman 2002 (sampling of rows); Koenker and Bassett 1978
     *   (quantile regression); Chernozhukov, Fernández-Val and Galichon 2010 (rearrangement).
     */
    @Literature { keys := ["friedman2001greedy", "friedman2002stochastic", "koenker1978regression",
                           "chernozhukov2010quantile"]; }
    @RequiresScale { minimum := 'measurement-scale.ordinal'; features := path "/task/inputs"; }
    type 'gradient-boosting' extends surrogate {
        /**
         * The prediction of the model: mean, the trees minimise the squared error (good for
         *   data without outliers); median, the trees fit the 0.5 quantile (robust against
         *   outliers, and it lies between the bounds).
         */
        'point-prediction' : enum 'point-prediction';

        /**
         * The number of trees of each of the three models.
         */
        @LowerBoundary{ boundary := 1; }
        'number-trees' : int;

        /**
         * The weight of each tree (learning rate). A smaller value needs more trees and
         *   generalises better, e.g. 0.05.
         */
        @LowerBoundary{ boundary := 0.0; inclusive := false; }
        @UpperBoundary{ boundary := 1.0; }
        shrinkage : real;

        /**
         * The maximum depth of a tree.
         */
        @LowerBoundary{ boundary := 2; }
        'max-depth' : int;

        /**
         * The maximum number of leaves of a tree.
         */
        @LowerBoundary{ boundary := 2; }
        'max-nodes' : int;

        /**
         * The minimum number of training rows in a leaf. The bounds are quantiles of the rows
         *   in a leaf, so a leaf needs enough rows for them, e.g. 5 or more.
         */
        @LowerBoundary{ boundary := 1; }
        'node-size' : int;

        /**
         * The share of the training rows each tree is fitted on, drawn without replacement for
         *   every tree. 1 uses all rows; a value below 1 (e.g. 0.7) makes the trees differ and
         *   often generalises better.
         */
        @LowerBoundary{ boundary := 0.0; inclusive := false; }
        @UpperBoundary{ boundary := 1.0; }
        'sampling-fraction' : real;

        /**
         * Which rows the trees of the three models (prediction, lower and upper bound) are
         *   fitted on with 'sampling-fraction' < 1: shared, tree t of every model sees the same
         *   rows; independent, every model draws its own rows. With 'sampling-fraction' 1, every
         *   tree sees all rows, and both give the same model.
         */
        'row-sampling' : enum 'row-sampling';

        /**
         * The probability that a new observation lies in the prediction interval, e.g. 0.9 for
         *   the interval between the 0.05 and the 0.95 quantile.
         */
        @LowerBoundary{ boundary := 0.0; inclusive := false; }
        @UpperBoundary{ boundary := 1.0; inclusive := false; }
        coverage : real;
    }
}