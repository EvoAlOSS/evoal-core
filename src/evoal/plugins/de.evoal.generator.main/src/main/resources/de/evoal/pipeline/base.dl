import "definitions" from 'de.evoal.core.base';
import "definitions" from 'de.evoal.core.constraints';

module 'de.evoal.pipeline.base' {
    /**
     * Base type for all pipeline elements.
     */
    abstract type Component extends configuration {}

    /**
     * A single step in a pipeline
     */
    abstract type Step extends Component {}

    /**
     * A step that processes input data and generates output data, e.g. it fills the data of a
     *   row ('distribution-based-data', 'sequence-generator') or computes data from other data
     *   (a benchmark).
     */
    abstract type Processor extends Step {}

    /**
     * A component that generates data without consuming, e.g. 'reader'. It is the first step
     *   of a pipeline that execute runs.
     */
    abstract type Source extends Step {}

    /**
     * A step that passes on the rows that satisfy its condition and drops the others. In
     *   write ... with n samples, the n rows are counted after the filters, so the file holds
     *   n rows that passed every filter.
     */
    abstract type Filter extends Step {
        /**
         * The number of rows in a row that the filter may drop. If the filter drops that many
         *   rows one after the other, the run stops with an error, e.g. when the data never
         *   satisfies the condition.
         */
        @LowerBoundary { boundary := 1; }
        'maximum-consecutive-rejections' : int;
    }

    /**
     * A component that acts when the stream of rows has ended, e.g., to estimate values from
     *   all rows or to write a file. It passes the rows on unchanged.
     */
    abstract type Sink extends Step {}

    /**
     * Function for calling the pipeline-based generator.
     *
     * @param filename The filename to write.
     * @param count The number of data points to write.
     * @param pipelines The pipelines to execute for data generation.
     */
    def void generate(string filename, int count, array literal pipelines);

    /**
     * Executes a pipeline once: its first step is the source (e.g. 'reader'), and the
     *   pipeline ends when the source has no more data. Sinks (e.g. 'correlation-estimation',
     *   'template', 'csv-writer') act when the stream has ended.
     *
     * @param pipeline The name of a pipeline of the module, e.g. execute("main");.
     */
    def void execute(string 'pipeline');
}