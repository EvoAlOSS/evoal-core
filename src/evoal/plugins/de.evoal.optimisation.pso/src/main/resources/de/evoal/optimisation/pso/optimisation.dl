import "definitions" from 'de.evoal.core.constraints';

import "definitions" from de.evoal.optimisation.core;
import "definitions" from 'de.evoal.core.base';

module de.evoal.optimisation.pso.optimisation {
	/**
	 * How a particle is kept within the boundaries of a variable after a move.
	 *
	 *   wrap:   the position enters the range from the other side (periodic
	 *           boundaries); the velocity is kept.
	 *   bounce: the position is reflected at the boundary and the velocity
	 *           component is negated.
	 *   stick:  the position is set to the boundary and the velocity component
	 *           to 0.
	 */
	nominal enum 'boundary-handling' ( wrap, bounce, stick );
	
	nominal enum 'topology' ( global, star, ring, square );
	
	/**
	 * Particle swarm optimisation (Kennedy and Eberhart 1995). Supports only real search
	 *   variables; the memory model's bestSoFar is the best personal best of the swarm.
	 */
	@Literature { keys := ["kennedy1995particle"]; }
	type 'particle-swarm-optimisation' extends 'algorithm' {
	    'swarm' : instance swarm;
	    'size-of-population'  : int;

	    'neighborhood-size' : int;
	    'mover' : instance 'pso-mover';
	    'topology' : enum topology := topology.global;
	}

	abstract type 'swarm' extends configuration {
	}

	type 'default-swarm' extends 'swarm' {
	}

	/**
	 * Swarm that switches between attraction and repulsion depending on its
	 *   diversity (Riget and Vesterstroem 2002). Requires the 'arpso-mover' and a lower
	 *   and an upper boundary for every search variable.
	 */
	@Literature { keys := ["riget2002diversity"]; }
	type 'arpso-swarm' extends 'swarm' {
        'diversity-low' : real; //example: 0.000005
        'diversity-high' : real; //example: 0.25
	}

    /**
     * Base type for all particle swarm moving strategies.
     */
	abstract type 'pso-mover' extends configuration {
	    //specify WRAP, BOUNCE, or STICK boundary type
	    'boundary-type' : enum  'boundary-handling' := 'boundary-handling.wrap';
	}

    /**
     * Basic PSO moving strategy.
     */
	type 'basic-mover' extends 'pso-mover' {
	    /**
	     * Starting value of inertia weight.
	     */
	    'inertia-start' : real;

	    /**
	     * Ending value of inertia weight.
	     */
	    'inertia-end' : real;

	    /**
	     * Number of generations until the inertia weight reaches 'inertia-end'.
	     *   The weight changes linearly from 'inertia-start' and stays at
	     *   'inertia-end' afterwards.
	     */
	    @LowerBoundary { boundary := 1; }
	    'inertia-iterations' : int;

        /**
         * Parameter c1 of basic PSO kinematic equation. Weights influence of individual memory.
         */
        'c1' : real;

        /**
         * Paramter c2 of basic PSO kinematic equation. Weights influence of collective memory.
         */
         'c2' : real;
	}

    /**
     * Fully informed particle swarm (FIPS) mover of Rui Mendes.
     */
	type 'fips-mover' extends 'pso-mover' {
	    /**
	     * Parameter phi of FIPS mover. The constriction factor
	     *   2 / |2 - phi - sqrt(phi^2 - 4 phi)| is only defined for phi >= 4.
	     */
	    @LowerBoundary { boundary := 4.0; inclusive := true; }
	    phi : real;
	}

	/**
	 * PSO mover with the constriction factor of Clerc and Kennedy 2002. The factor
	 *   2 / |2 - phi - sqrt(phi^2 - 4 phi)| with phi = c1 + c2 is only defined for
	 *   phi >= 4.
	 */
	@MultiVariateConstraint { 'expression' := self.'c1' + self.'c2' >= 4.0; }
	@Literature { keys := ["clerc2002particle"]; }
	type 'constriction-factor-mover' extends 'pso-mover' {
         /**
          * Parameter c1 of basic PSO kinematic equation. Weights influence of individual memory.
          */
         'c1' : real;

         /**
          * Paramter c2 of basic PSO kinematic equation. Weights influence of collective memory.
          */
          'c2' : real;
    }

    /**
     *  Attractive-repulsive PSO Mover (short ARPSOMover), based on Riget and
     *    Vesterstroem 2002.
     */
    @Literature { keys := ["riget2002diversity"]; }
    type 'arpso-mover' extends 'pso-mover' {
	    /**
	     * Starting value of inertia weight. Should be less than 1.
	     */
	    'inertia-start' : real;

	    /**
	     * Ending value of inertia weight.
	     */
	    'inertia-end' : real;

	    /**
	     * Number of generations until the inertia weight reaches 'inertia-end'.
	     *   The weight changes linearly from 'inertia-start' and stays at
	     *   'inertia-end' afterwards.
	     */
	    @LowerBoundary { boundary := 1; }
	    'inertia-iterations' : int;

        /**
         * Parameter c1 of basic PSO kinematic equation. Weights influence of individual memory.
         */
        'c1' : real;

        /**
         * Parameter c2 of basic PSO kinematic equation. Weights influence of collective memory.
         */
         'c2' : real;
    }
}