module 'de.evoal.core.constraints' {
    /**
     * How serious the violation of a constraint is:
     *   - error: the value cannot work, e.g. a parameter the library rejects; a configuration
     *     with such a value does not start, and 'constraint-validation' drops such a row by
     *     default.
     *   - warning: the value works but is likely a mistake, e.g. a kernel that is likely not
     *     positive definite; the run reports it and continues, and 'constraint-validation'
     *     keeps such a row by default.
     */
    nominal enum Severity ( error, warning );

    /**
     * Base type for EvoAl constraints.
     */
    abstract type Constraint {
        /**
         * How serious a violation of the constraint is. Annotations without a checker (e.g.
         *   @Literature) ignore it.
         */
        severity : enum Severity := Severity.error;
    }

    /**
     * A lower bound for numeric values.
     */
    type LowerBoundary extends Constraint {
        /**
         * The lower bound value (integer or real).
         */
        boundary : literal;

        /**
         * If the bound is included (or not).
         */
        inclusive : boolean := true;
    }

    /**
     * An upper bound for numeric values.
     */
    type UpperBoundary extends Constraint {
        /**
         * The upper bound value (integer or real).
         */
        boundary : literal;

        /**
         * If the bound is included (or not).
         */
        inclusive : boolean := true;
    }

    type MultiVariateConstraint extends Constraint {
        'expression' : expression;
    }

    /**
     * Constraint that specifies a minimum number of elements for arrays.
     */
    type MinimumNumberOfElements extends Constraint {
        /**
         * The minimum number of elements
         */
        bound : int;
    }

    /**
     * Constraint that specifies a maximum number of elements for arrays.
     */
    type MaximumNumberOfElements extends Constraint {
        /**
         * The maximum number of elements
         */
        bound : int;
    }

    /**
     * Names the literature of a DL type or of a declaration ({@code def}) by BibTeX keys,
     *   e.g. {@code @Literature { keys := ["harik1996learning"]; }}. The full entries are in
     *   <tt>META-INF/evoal/credits.bib</tt> of the plugin that declares the type, or of a
     *   module it depends on; the build fails for a key without an entry. A type also has
     *   the literature of its super types. A run lists the literature of the types and
     *   declarations its configuration uses in <tt>citations.bib</tt>.
     */
    type Literature extends Constraint {
        /**
         * The BibTeX keys of the sources.
         */
        @MinimumNumberOfElements { bound := 1; }
        keys : array string;
    }
}
