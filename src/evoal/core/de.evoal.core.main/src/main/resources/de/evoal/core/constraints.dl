module 'de.evoal.core.constraints' {
    /**
     * How serious the violation of a constraint is:
     *   - error: the value cannot work, e.g. a parameter the library rejects; a configuration
     *     with such a value does not start, and 'constraint-validation' drops such a row by
     *     default.
     *   - warning: the value works but is likely a mistake, e.g. a kernel that is likely not
     *     positive definite; the run reports it and continues, and 'constraint-validation'
     *     keeps such a row by default.
     */
    nominal enum Severity ( error, warning );

    /**
     * The scales of measurement of the DDL, from the weakest to the strongest:
     *   'nominal' < 'ordinal' < 'cardinal' < 'quotient'.
     */
    nominal enum 'measurement-scale' ( 'nominal', 'ordinal', 'cardinal', 'quotient' );

    /**
     * The representations of DDL data: 'real', 'integer', 'boolean' and 'string' data.
     */
    nominal enum representation ( 'real', 'integer', 'boolean', 'string' );

    /**
     * Base type for EvoAl constraints.
     */
    abstract type Constraint {
        /**
         * How serious a violation of the constraint is. Annotations without a checker (e.g.
         *   @Literature) ignore it.
         */
        severity : enum Severity := Severity.error;
    }

    /**
     * A lower bound for numeric values. On a numeric attribute of a DL type it is also the
     *   bound the random builder of model candidates draws within.
     */
    type LowerBoundary extends Constraint {
        /**
         * The lower bound value (integer or real).
         */
        boundary : literal;

        /**
         * If the bound is included (or not).
         */
        inclusive : boolean := true;
    }

    /**
     * An upper bound for numeric values. On a numeric attribute of a DL type it is also the
     *   bound the random builder of model candidates draws within.
     */
    type UpperBoundary extends Constraint {
        /**
         * The upper bound value (integer or real).
         */
        boundary : literal;

        /**
         * If the bound is included (or not).
         */
        inclusive : boolean := true;
    }

    /**
     * A condition on the attributes of an instance, e.g.
     *   {@code @MultiVariateConstraint { 'expression' := self.'lower' < self.'upper'; }}. Besides
     *   {@code self.'a'.'b'}, the condition can select objects of the configuration tree with path
     *   expressions ({@code path "…"}, evaluated from the instance) and the functions
     *   {@code count}, {@code exists}, {@code min} and {@code max} on their selections.
     */
    type MultiVariateConstraint extends Constraint {
        'expression' : expression;
    }

    /**
     * The number of objects and values the path expression selects, e.g.
     *   {@code count(path "../features")}.
     */
    def int count(path selection);

    /**
     * Whether the path expression selects anything.
     */
    def boolean exists(path selection);

    /**
     * The largest number the path expression selects; an error if it selects nothing.
     */
    def real max(path selection);

    /**
     * The smallest number the path expression selects; an error if it selects nothing.
     */
    def real min(path selection);

    /**
     * Constraint that specifies a minimum number of elements for arrays. On an attribute of a DL
     *   type it is also the lower multiplicity of the attribute, which the random builder of
     *   model candidates respects.
     */
    type MinimumNumberOfElements extends Constraint {
        /**
         * The minimum number of elements
         */
        bound : int;
    }

    /**
     * Constraint that specifies a maximum number of elements for arrays. On an attribute of a DL
     *   type it is also the upper multiplicity of the attribute; the random builder of model
     *   candidates needs it for every array of a model.
     */
    type MaximumNumberOfElements extends Constraint {
        /**
         * The maximum number of elements
         */
        bound : int;
    }

    /**
     * The scale of measurement of a DL attribute, e.g.
     *   {@code @Scale { scale := 'measurement-scale.cardinal'; }} on a real attribute whose
     *   differences are meaningful. It plays the role the scale of DDL data plays: operators that
     *   change the attribute in a model candidate depend on it. An attribute without @Scale is
     *   nominal; an attribute of an enum type has the scale of its enum.
     */
    type Scale extends Constraint {
        /**
         * The scale of the attribute.
         */
        scale : enum 'measurement-scale';
    }

    /**
     * A requirement of a component on the data it works on, e.g. a particle swarm on the search
     *   variables of its problem. The requirement is checked for every instance of the annotated
     *   type when a configuration is loaded, for every data its 'features' select.
     */
    abstract type FeatureRequirement extends Constraint {
        /**
         * Selects the data the requirement applies to, starting at the annotated instance, e.g.
         *   {@code path "/algorithm/problem/searchSpace"} for the search variables of the problem
         *   or {@code path "../features"} for the features of the containing instance.
         */
        features : path;
    }

    /**
     * The selected data needs at least the given scale of measurement, e.g.
     *   {@code @RequiresScale { minimum := 'measurement-scale.cardinal'; features := path "…"; }}
     *   for a component that computes differences. Data without a scale is nominal, typed data
     *   has the scale of its type.
     */
    type RequiresScale extends FeatureRequirement {
        /**
         * The weakest scale the data may have.
         */
        minimum : enum 'measurement-scale';
    }

    /**
     * The selected data needs one of the given representations, e.g.
     *   {@code @RequiresRepresentation { representations := ['representation.real']; features := path "…"; }}.
     */
    type RequiresRepresentation extends FeatureRequirement {
        /**
         * The representations the data may have.
         */
        @MinimumNumberOfElements { bound := 1; }
        representations : array enum representation;
    }

    /**
     * The selected data needs a lower and/or an upper boundary ({@code @LowerBoundary},
     *   {@code @UpperBoundary} of the data or of its type); the range of the representation does
     *   not count, except for boolean data, which is always bounded (false and true).
     */
    type RequiresBoundaries extends FeatureRequirement {
        /**
         * Whether the data needs a lower boundary.
         */
        lower : boolean := false;

        /**
         * Whether the data needs an upper boundary.
         */
        upper : boolean := false;
    }

    /**
     * The path must select at least one object, e.g.
     *   {@code @Requires { selection := path "../mover[arpso-mover]"; }} on a component that only
     *   works with a particular sibling. Alternatives are a union in the path
     *   ({@code path "../mover[a] | ../mover[b]"}); several {@code @Requires} on a type must all
     *   hold. Checked for every instance of the annotated type when a configuration is loaded.
     */
    type Requires extends Constraint {
        /**
         * The path, evaluated from the annotated instance.
         */
        selection : path;
    }

    /**
     * The path must select nothing, e.g. {@code @Excludes { selection := path "../mover[basic-mover]"; }}.
     *   Checked for every instance of the annotated type when a configuration is loaded.
     */
    type Excludes extends Constraint {
        /**
         * The path, evaluated from the annotated instance.
         */
        selection : path;
    }

    /**
     * The number of fitness components a component needs, e.g.
     *   {@code @RequiresFitnessComponents { minimum := 1; maximum := 1; }} on a selection that
     *   works on a single fitness value. The number follows from the goals of the problem and the
     *   steps of the fitness pipeline (a scalarisation makes one), so it is checked when the
     *   optimisation run builds its fitness pipeline, before the first evaluation, for every
     *   configuration of the annotated type in the algorithm.
     */
    type RequiresFitnessComponents extends Constraint {
        /**
         * The smallest number of fitness components.
         */
        @LowerBoundary { boundary := 1; }
        minimum : int := 1;

        /**
         * The largest number of fitness components; no limit if it is not set.
         */
        @LowerBoundary { boundary := 1; }
        maximum : optional int;
    }

    /**
     * Names the literature of a DL type or of a declaration ({@code def}) by BibTeX keys,
     *   e.g. {@code @Literature { keys := ["harik1996learning"]; }}. The full entries are in
     *   <tt>META-INF/evoal/credits.bib</tt> of the plugin that declares the type, or of a
     *   module it depends on; the build fails for a key without an entry. A type also has
     *   the literature of its super types. A run lists the literature of the types and
     *   declarations its configuration uses in <tt>citations.bib</tt>.
     */
    type Literature extends Constraint {
        /**
         * The BibTeX keys of the sources.
         */
        @MinimumNumberOfElements { bound := 1; }
        keys : array string;
    }
}
