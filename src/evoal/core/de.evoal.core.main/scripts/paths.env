EVOALPATH=$( cd -- "$(dirname $0)/.." >/dev/null 2>&1 ; pwd -P )
PLUGIN_PATHS=`ls -d "${EVOALPATH}/plugins"/* | tr '\n' ':'`

CLASSPATH=(-Dorg.jboss.logging.provider=slf4j\
          --module-path ${EVOALPATH}/modules/:$PLUGIN_PATHS \
          --add-modules ALL-MODULE-PATH \
          --add-exports io.jenetics.base/io.jenetics.internal.math=de.evoal.core.pso \
          --add-exports io.jenetics.base/io.jenetics.internal.collection=de.evoal.core.pso \
          --add-exports io.jenetics.base/io.jenetics.internal.util=de.evoal.core.pso \
          -m de.evoal.core.main/de.evoal.core.main.Evoal)
