<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.evoal</groupId>
        <artifactId>releng.core</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>releng.regressions</artifactId>

    <name>EvoAl - Core - Regressions</name>

    <description>
        Runs the regression configurations (src/test/regressions of every plugin) against the assembled
        release and compares their output with the stored references (expected/). The runs are only
        executed with the profile 'regressions'.
    </description>

    <properties>
        <!-- root folder of the repository, contains ci/ and the release folder evoal/ -->
        <evoal.regressions.root>${project.basedir}/../../../..</evoal.regressions.root>

        <!-- number of runs per regression, all runs must give the same output -->
        <evoal.regressions.repetitions>1</evoal.regressions.repetitions>

        <!-- true also runs the examples: examples with references are compared, the others are smoke tests -->
        <evoal.regressions.examples>false</evoal.regressions.examples>

        <!-- shell that executes the search launcher (bin/evoal-search.sh needs bash 4 or newer, or zsh) -->
        <evoal.regressions.shell>bash</evoal.regressions.shell>

        <!-- number of threads that evaluate the candidates of a run (EVOAL_THREADS); the output does not depend on it -->
        <evoal.regressions.threads>1</evoal.regressions.threads>

        <!-- number of regressions that run at the same time; the output does not depend on it -->
        <evoal.regressions.parallelism>1</evoal.regressions.parallelism>

        <!-- true rewrites the references instead of comparing against them -->
        <evoal.regressions.update>false</evoal.regressions.update>

        <!-- the module has tests only and no jar, there is nothing to install or deploy -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- The release contains these modules, so they have to be built before the release is assembled. -->
        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>core.arff</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>core.main</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>generator.main</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>optimisation.api</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>optimisation.local_search</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>optimisation.cma_es</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>optimisation.ea</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>optimisation.pso</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>optimisation.random_search</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>surrogate.adaption</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>surrogate.api</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>surrogate.knn</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>surrogate.simple</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>${project.parent.groupId}</groupId>
            <artifactId>surrogate.smile</artifactId>
            <version>${project.parent.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The module has tests only. An empty jar would fail when 'package' runs twice (verify package). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skipIfEmpty>true</skipIfEmpty>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Assembles the release and runs the regressions against it. -->
        <profile>
            <id>regressions</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>create-release</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>sh</executable>
                                    <workingDirectory>${evoal.regressions.root}</workingDirectory>
                                    <arguments>
                                        <argument>ci/create-release.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.2</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <systemPropertyVariables>
                                <evoal.regressions.examples>${evoal.regressions.examples}</evoal.regressions.examples>
                                <evoal.regressions.parallelism>${evoal.regressions.parallelism}</evoal.regressions.parallelism>
                                <evoal.regressions.repetitions>${evoal.regressions.repetitions}</evoal.regressions.repetitions>
                                <evoal.regressions.root>${evoal.regressions.root}</evoal.regressions.root>
                                <evoal.regressions.shell>${evoal.regressions.shell}</evoal.regressions.shell>
                                <evoal.regressions.threads>${evoal.regressions.threads}</evoal.regressions.threads>
                                <evoal.regressions.update>${evoal.regressions.update}</evoal.regressions.update>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Measures the coverage of the regression runs (together with the profile 'regressions'). -->
        <profile>
            <id>jacoco</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>${jacoco.version}</version>
                        <executions>
                            <execution>
                                <id>regression-agent</id>
                                <goals>
                                    <goal>prepare-agent-integration</goal>
                                </goals>
                                <configuration>
                                    <destFile>${project.build.directory}/jacoco-regressions.exec</destFile>
                                    <propertyName>evoal.regressions.agent</propertyName>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <!-- set by prepare-agent-integration, therefore not defined in this pom -->
                                <evoal.regressions.agent>${evoal.regressions.agent}</evoal.regressions.agent>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
